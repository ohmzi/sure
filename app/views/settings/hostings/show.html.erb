<%# Self-hosting split by subject (the owner, 2026-10-17). One controller
    serves three Settings pages; each renders only its own sections:
    - AI: the assistant, the AI provider and cloud readers, categorization;
    - Data providers: market data, property valuations, logos;
    - Self-hosting: sync, invites, demo refresh and the danger zone. %>
<%= content_for :page_title, t(".titles.#{@section}") %>
<% case @section %>
<% when "ai" %>
<%= settings_section title: t(".ai_assistant") do %>
  <%= render "settings/hostings/assistant_settings" %>
<% end %>
<%# The AI provider gets its own titled section (spec N5, owner report
    2026-10-13) — it was buried under "General Settings" beside unrelated
    options, so a user hunting for where to enter a key or pick a local model
    could not find it. The anchor `ai-provider` is the destination the
    document hold panel links to. %>
<%= settings_section title: t(".ai_provider"), subtitle: t(".ai_provider_description") do %>
  <div id="ai-provider" class="space-y-6"
       data-controller="provider-settings"
       data-provider-settings-active-value="<%= Setting.llm_provider %>">
    <%= render "settings/hostings/llm_provider_selector" %>
    <%= tag.div data: { "provider-settings-target": "panel", provider: "openai" },
                hidden: Setting.llm_provider != "openai" do %>
      <%= render "settings/hostings/openai_settings" %>
    <% end %>
    <%= tag.div data: { "provider-settings-target": "panel", provider: "anthropic" },
                hidden: Setting.llm_provider != "anthropic" do %>
      <%= render "settings/hostings/anthropic_settings" %>
    <% end %>
    <%= tag.div data: { "provider-settings-target": "panel", provider: "local" },
                hidden: Setting.llm_provider != "local" do %>
      <%= render "settings/hostings/local_settings" %>
    <% end %>
    <%= render "settings/hostings/cloud_reader_settings" %>
  </div>
<% end %>
<% if preview_features_enabled? %>
  <%= settings_section title: t(".categorization") do %>
    <%= render "settings/hostings/categorization_provider_selector" %>
  <% end %>
<% end %>
<% when "data" %>
<%= settings_section title: t(".financial_data_providers") do %>
  <div class="space-y-6">
    <%= render "settings/hostings/provider_selection" %>
    <% if @show_yahoo_finance_settings %>
      <%= render "settings/hostings/yahoo_finance_settings" %>
    <% end %>
    <% if @show_twelve_data_settings %>
      <%= render "settings/hostings/twelve_data_settings" %>
    <% end %>
    <% if @show_tiingo_settings %>
      <%= render "settings/hostings/tiingo_settings" %>
    <% end %>
    <% if @show_eodhd_settings %>
      <%= render "settings/hostings/eodhd_settings" %>
    <% end %>
    <% if @show_alpha_vantage_settings %>
      <%= render "settings/hostings/alpha_vantage_settings" %>
    <% end %>
    <% if @show_tinkoff_invest_settings %>
      <%= render "settings/hostings/tinkoff_invest_settings" %>
    <% end %>
    <% if @show_mansa_settings %>
      <%= render "settings/hostings/mansa_settings" %>
    <% end %>
  </div>
<% end %>
<%= settings_section title: t(".property_valuation_providers") do %>
  <div class="space-y-6">
    <%= render "settings/hostings/rentcast_settings" %>
    <%= render "settings/hostings/realie_settings" %>
    <%= render "settings/hostings/chimnie_settings" %>
  </div>
<% end %>
<%= settings_section title: t(".logos") do %>
  <%= render "settings/hostings/brand_fetch_settings" %>
<% end %>
<% else %>
<%= settings_section title: t(".sync_settings") do %>
  <%= render "settings/hostings/sync_settings" %>
<% end %>
<% if Current.user.super_admin? %>
  <%= settings_section title: t(".invites") do %>
    <%= render "settings/hostings/invite_code_settings" %>
  <% end %>
<% end %>
<% if Current.user.super_admin? %>
  <%= settings_section title: t(".demo_refresh") do %>
    <%= render "settings/hostings/demo_refresh_settings" %>
  <% end %>
<% end %>
<%= settings_section title: t(".danger_zone") do %>
  <%= render "settings/hostings/danger_zone_settings" %>
<% end %>
<% end %>
