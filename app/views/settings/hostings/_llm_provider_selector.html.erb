<%
  stored = Setting.llm_provider.to_s.downcase
  active = Setting::LLM_PROVIDERS.include?(stored) ? stored : "openai"
  locked = ENV["LLM_PROVIDER"].present?
  providers = [
    [ "openai", t(".provider_openai") ],
    [ "anthropic", t(".provider_anthropic") ],
    [ "deepseek", t(".provider_deepseek") ],
    [ "gemini", t(".provider_gemini") ],
    [ "local", t(".provider_local") ]
  ]
  active_configured =
    case active
    when "anthropic" then Provider::Anthropic.configured?
    when "local" then Setting.local_llm_model.present?
    when "deepseek" then Setting.deepseek_api_key.present?
    when "gemini" then Setting.gemini_api_key.present?
    else Provider::Openai.configured?
    end
%>

<div class="space-y-3">
  <div>
    <h2 class="font-medium mb-1"><%= t(".title") %></h2>
    <% if locked %>
      <p class="text-sm text-secondary"><%= t(".env_configured_message") %></p>
    <% else %>
      <p class="text-secondary text-sm"><%= t(".description") %></p>
    <% end %>
  </div>

  <%= styled_form_with model: Setting.new,
                       url: settings_hosting_path,
                       method: :patch,
                       data: { "provider-settings-target": "form" } do |form| %>
    <%# Mobile: native picker. The segmented tabs overflow < sm once there are
        3+ providers, so below sm we fall back to a <select> — which is also the
        submitted field (the desktop tabs set its value via the controller). %>
    <div class="sm:hidden">
      <%= form.select :llm_provider,
                      options_for_select(providers.map { |key, label| [ label, key ] }, active),
                      { label: t(".provider_label") },
                      { disabled: locked,
                        data: { "provider-settings-target": "field",
                                action: (locked ? nil : "change->provider-settings#select") } } %>
    </div>

    <%# Desktop / tablet: segmented tabs (room to spare up to ~5 providers). %>
    <div class="hidden sm:block">
      <%= render DS::SegmentedControl.new(full_width: true, aria_label: t(".provider_label")) do |sc| %>
        <% providers.each do |key, label| %>
          <% sc.with_segment(label,
               active: active == key,
               disabled: locked,
               data: {
                 "provider-settings-target": "segment",
                 provider: key,
                 action: (locked ? nil : "click->provider-settings#select")
               }) %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <p class="text-xs text-secondary"><%= t(".provider_help") %></p>

  <% if !locked && !active_configured %>
    <p class="text-xs text-warning">
      <%= active == "local" ? t(".local_not_configured_hint") : t(".not_configured_hint", provider: t(".provider_#{active}")) %>
    </p>
  <% end %>

  <%= styled_form_with model: Setting.new,
                       url: settings_hosting_path,
                       method: :patch,
                       data: {
                         controller: "auto-submit-form",
                         "auto-submit-form-trigger-event-value": "blur"
                       } do |form| %>
    <%= form.number_field :llm_max_items_per_call,
                          label: t(".max_items_per_call_label"),
                          placeholder: "25",
                          value: Setting.llm_max_items_per_call,
                          min: 1,
                          disabled: ENV["LLM_MAX_ITEMS_PER_CALL"].present?,
                          data: { "auto-submit-form-target": "auto" } %>
    <p class="text-xs text-secondary mt-1"><%= t(".max_items_per_call_help") %></p>
  <% end %>

  <%= render DS::Note.new(title: t(".data_retention_heading")) do %>
    <p><%= t(".data_retention") %></p>
  <% end %>
</div>
