<%# locals: (title:, count: nil, description: nil, anchor: nil) %>
<%= tag.div id: anchor.presence, class: "flex items-baseline justify-between gap-3 mt-7 mb-2.5 px-1" do %>
  <h2 class="text-xl font-extrabold tracking-tight text-primary flex items-baseline gap-2">
    <%= title %>
    <% if count %>
      <span class="text-sm font-semibold text-secondary tabular-nums"><%= count %></span>
    <% end %>
  </h2>
  <% if description.present? %>
    <p class="text-xs text-secondary"><%= description %></p>
  <% end %>
<% end %>
