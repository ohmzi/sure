<%= content_for :page_title, t(".page_title") %>

<%= settings_section title: t(".theme_title"), subtitle: t(".theme_subtitle") do %>
  <div data-controller="theme" data-theme-user-preference-value="<%= @user.theme %>">
    <%# Three side by side at every width, the picked one ringed and ticked
        (the Settings audit, 2026-10-19); they used to stack full width on a
        phone, three screens of pictures. %>
    <%= form_with model: @user, class: "grid grid-cols-3 gap-2 sm:gap-4", id: "theme_form",
        data: { controller: "auto-submit-form", auto_submit_form_trigger_event_value: "change" } do |form| %>
      <%= form.hidden_field :redirect_to, value: "appearance" %>

      <% theme_option_class = "press relative flex flex-col items-center gap-2 rounded-2xl p-2 sm:p-3 text-center ring-1 ring-transparent transition-[background-color,box-shadow] duration-200 hover:bg-surface-hover cursor-pointer [&:has(input:checked)]:bg-surface-hover [&:has(input:checked)]:ring-2 [&:has(input:checked)]:ring-link" %>

      <% [
        { value: "light", image: "light-mode-preview.png" },
        { value: "dark", image: "dark-mode-preview.png" },
        { value: "system", image: "system-mode-preview.png" }
      ].each do |theme| %>
        <%= form.label :"theme_#{theme[:value]}", class: "group block" do %>
          <div class="<%= theme_option_class %>">
            <span class="absolute right-2 top-2 hidden size-5 items-center justify-center rounded-full bg-inverse text-inverse group-has-[input:checked]:flex" aria-hidden="true">
              <%= icon("check", size: "xs", color: "current") %>
            </span>
            <%= image_tag(theme[:image], alt: "#{theme[:value].titleize} Theme Preview", class: "w-full max-h-32 object-contain rounded-lg") %>
            <div class="text-sm font-semibold text-primary">
              <%= form.radio_button :theme, theme[:value], checked: @user.theme == theme[:value], class: "sr-only",
                data: { auto_submit_form_target: "auto", autosubmit_trigger_event: "change", action: "theme#updateTheme" } %>
              <%= t(".theme_#{theme[:value]}") %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>

<%= settings_section title: t(".dashboard_title"), subtitle: t(".dashboard_subtitle") do %>
  <div>
    <%= form_with url: settings_appearance_path, method: :patch,
          class: "p-3 space-y-4",
          data: { controller: "auto-submit-form" } do |f| %>
      <div class="flex cursor-pointer items-center gap-4 justify-between">
        <div class="text-sm space-y-1">
          <p class="text-primary font-medium"><%= t(".dashboard_two_column_title") %></p>
          <p class="text-secondary"><%= t(".dashboard_two_column_description") %></p>
        </div>
        <%= render DS::Toggle.new(
              id: "user_dashboard_two_column",
              name: "user[dashboard_two_column]",
              checked: @user.dashboard_two_column?,
              data: { auto_submit_form_target: "auto" }
        ) %>
      </div>

      <div class="border-t border-primary pt-4">
        <div class="text-sm space-y-1 mb-3">
          <p class="text-primary font-medium"><%= t(".dashboard_account_groups_title") %></p>
          <p class="text-secondary"><%= t(".dashboard_account_groups_description") %></p>
        </div>
        <div class="grid gap-2 sm:grid-cols-2">
          <% selected = @user.always_expanded_account_groups %>
          <% Accountable::TYPES.each do |type| %>
            <% key = type.underscore %>
            <% checked = selected.include?(key) %>
            <label class="flex cursor-pointer items-center gap-2.5 rounded-lg px-3 py-2 hover:bg-surface-inset transition-colors"
                   for="user_account_groups_<%= key %>">
              <%= hidden_field_tag "user[account_groups][]", "", id: nil %>
              <%= check_box_tag "user[account_groups][]", key, checked,
                    id: "user_account_groups_#{key}",
                    class: "checkbox checkbox--light mt-0.5",
                    data: { auto_submit_form_target: "auto" } %>
              <span class="text-sm text-primary"><%= Accountable.from_type(type).display_name %></span>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

