<%# locals: (name:, path:, icon:) %>
<%# The settings list entry, in the same language as the main navigation
    (2026-10-17): a tinted pill and the brand colour mark where you are. %>
<%= link_to path, class: class_names(
  "flex items-center gap-2.5 whitespace-nowrap px-3.5 py-2 rounded-full text-sm focus-ring active:scale-[0.98] transition",
  page_active?(path) ? "text-link font-semibold button-bg-accent" : "text-secondary hover:bg-surface-hover hover:text-primary"
), aria: { current: ("page" if page_active?(path)) } do %>
  <%= icon(icon, color: "current") if icon %>
  <%= name %>
<% end %>
