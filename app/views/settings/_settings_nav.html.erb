<%# The Settings list (the owner's iOS redesign, 2026-10-17): your profile as
    the first row, then inset grouped lists — a tinted icon tile, the label, a
    chevron — and Log out on its own at the end. The same list is a phone's
    Settings page and a computer's left pane, where the open page is marked. %>
<nav aria-label="<%= t("settings.settings_nav.title", default: "Settings") %>" class="space-y-7">
  <%= link_to settings_profile_path, class: class_names(
        "flex items-center gap-3.5 rounded-2xl bg-container p-3.5 shadow-border-xs active:scale-[0.99] transition focus-ring",
        ("ring-2 ring-link" if page_active?(settings_profile_path))
      ), aria: { current: ("page" if page_active?(settings_profile_path)) } do %>
    <div class="size-14 shrink-0">
      <%= render "settings/user_avatar", avatar_url: (Current.user.profile_image.attached? ? Current.user.profile_image.variant(:small) : nil), initials: Current.user.initials %>
    </div>
    <div class="min-w-0 grow">
      <p class="truncate text-lg font-semibold text-primary"><%= Current.user.display_name %></p>
      <p class="truncate text-sm text-secondary"><%= Current.user.email %></p>
    </div>
    <%= icon("chevron-right", size: "sm") %>
  <% end %>

  <% settings_nav_sections.each do |section| %>
    <section>
      <h3 class="px-4 mb-2 text-xs font-medium uppercase tracking-wide text-secondary"><%= section[:header] %></h3>
      <ul class="overflow-hidden rounded-2xl bg-container shadow-border-xs divide-y divide-subdued">
        <% section[:items].each do |item| %>
          <li>
            <%= render "shared/list_row", label: item[:label], path: item[:path], icon: item[:icon], tint: item[:tint], active: page_active?(item[:path]) %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section>
    <div class="overflow-hidden rounded-2xl bg-container shadow-border-xs">
      <%= button_to session_path(Current.session), method: :delete,
            class: "flex w-full items-center justify-center min-h-12 text-base font-medium text-destructive hover:bg-container-hover focus-ring" do %>
        <%= t("settings.settings_nav.logout") %>
      <% end %>
    </div>
  </section>
</nav>
