<%# locals: (statement:, accounts:) %>
<%# "Which account?" answered on the tile itself (spec §6): the accounts the
    signed-in person can reach, the statement's suggestion preselected. A live
    update renders with no one signed in, so it links to the statement's own
    picker instead of listing accounts. The link action enforces who may move a
    statement either way. %>
<% if accounts %>
  <%= form_with url: link_account_statement_path(statement), method: :patch,
                class: "flex items-end gap-1.5", data: { turbo_frame: "_top" } do |form| %>
    <div class="min-w-0 flex-1">
      <%= render DS::Select.new(form: form, method: :account_id,
                                items: accounts.map { |account| { label: account.name, value: account.id } },
                                selected: statement.suggested_account_id,
                                include_blank: t("document_browser.account_picker.prompt"),
                                placeholder: t("document_browser.account_picker.prompt"),
                                menu_placement: :up) %>
    </div>
    <%= render DS::Button.new(text: t("document_browser.account_picker.submit"), type: "submit", variant: :primary, size: :sm) %>
  <% end %>
<% else %>
  <%= render DS::Link.new(text: t("document_browser.account_picker.label"), href: account_statement_path(statement),
                          variant: "outline", size: "sm") %>
<% end %>
