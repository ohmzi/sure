<%# locals: (row:, panel: nil, previous_url: nil, previous_title: nil, next_url: nil, next_title: nil) %>
<%# The viewer (M8's modal; Milestone B design D4 gives it two modes). It opens
    as a lightbox — the document full-bleed, minimal chrome, ←/→ to move, Esc to
    close. Once there is a read worth showing it becomes a split: document left,
    what was understood right. A document the read produced nothing for stays a
    picture; an unread one still says why, never an empty panel.
    `panel` is optional because the Statements vault shares this partial (its
    viewer predates the Documents panel and passes none — it stays a lightbox). %>
<%= render DS::Dialog.new(width: "expanded", scrollable: false, content_class: "h-[85vh]") do |dialog| %>
  <% dialog.with_header(title: row.title, subtitle: row.doc_type_label) %>
  <%# Its own margins (the content slot has none) — the sheet's controls and
      panel no longer touch the screen's edges (2026-10-17). %>
  <div class="flex h-full min-h-0 flex-col gap-4 px-4 pb-4"
       data-controller="document-viewer"
       data-action="keydown.left@window->document-viewer#previous keydown.right@window->document-viewer#next">
    <div class="flex items-center justify-between gap-2">
      <%= render "document_browser/viewer_nav", direction: :previous, url: previous_url, title: previous_title %>
      <div class="flex flex-wrap items-center justify-center gap-2">
        <% row.statuses.each do |status| %>
          <%= render DS::Pill.new(label: status.label, tone: status.tone, marker: false) %>
        <% end %>
        <%# The document's own affordances live here now (Milestone B Task 4):
            the viewer absorbed the tile's action row, so the tile is purely
            visual — Review details / Reading… / Retry / Remove are reached from
            the document itself. %>
        <%= render "document_browser/actions", row: row, container_class: "flex items-center gap-3" %>
        <%# The stable, shareable page for this document (`Row#details_url`, Task
            4). The modal is the entry point; this breaks out of the modal frame
            to the full page, which needs no JavaScript. %>
        <% if row.details_url.present? %>
          <%= link_to row.details_url,
                class: "inline-flex items-center justify-center size-10 rounded-full border border-secondary bg-container text-primary hover:bg-container-hover active:scale-95 transition focus-ring",
                title: t("document_browser.viewer.open_full_page"),
                aria: { label: t("document_browser.viewer.open_full_page") },
                data: { turbo_frame: "_top" } do %>
            <%= icon("maximize-2", size: "sm") %>
          <% end %>
        <% end %>
      </div>
      <%= render "document_browser/viewer_nav", direction: :next, url: next_url, title: next_title %>
    </div>

    <% if panel&.shows_panel? %>
      <%= render "document_browser/viewer_split", row: row, panel: panel %>
    <% else %>
      <%= render "document_browser/viewer_stage", row: row %>
    <% end %>
  </div>
<% end %>
