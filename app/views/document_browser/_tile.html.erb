<%# locals: (row:) %>
<%
  # The tile's one state, in priority order (design D3/D5). Every input is a
  # field DocumentBrowser::Row already carries — the link's status and failure
  # message, its draft, and its archived statement. Nothing here re-reads the
  # database beyond what the row factory loaded.
  record = row.record
  draft = record.receipt_imports.max_by(&:created_at)
  statement = record.account_statement

  state =
    if row.failure_message.present?
      :needs_you
    elsif record.status == "processing" || (record.status == "queued" && row.failure_message.blank?)
      :reading
    elsif draft&.understanding_state == "understood" && draft.status != "complete"
      draft.account_id.nil? ? :which_account : :review
    elsif statement&.needs_account?
      :which_account
    elsif record.status.in?(%w[linked verified])
      :posted
    elsif statement.present?
      :review
    end

  # The state pill's label and tone. The tones come from the SAME constant the
  # row reads (DocumentBrowser::Row::STATUS_TONES), never new literals, so a
  # retune of the palette reaches the tile (review ruling 4). Each state borrows
  # the link vocabulary that carries its meaning today: a held read is `failed`,
  # an in-flight one `processing`, a document waiting on a person
  # `pending_review`, a published one `verified`.
  tile_states = {
    needs_you: [ t("document_browser.tile.states.needs_you"), DocumentBrowser::Row::STATUS_TONES.fetch("failed") ],
    reading: [ t("document_browser.tile.states.reading"), DocumentBrowser::Row::STATUS_TONES.fetch("processing") ],
    which_account: [ t("document_browser.tile.states.which_account"), DocumentBrowser::Row::STATUS_TONES.fetch("pending_review") ],
    review: [ t("document_browser.tile.states.review"), DocumentBrowser::Row::STATUS_TONES.fetch("pending_review") ],
    posted: [ t("document_browser.tile.states.posted"), DocumentBrowser::Row::STATUS_TONES.fetch("verified") ]
  }
  # No design state applies (e.g. a settled, unlinked row with no draft): the
  # link's own status pill is the honest answer, exactly as the row showed it.
  state_label, state_tone = tile_states.fetch(state, [ row.statuses.first&.label, row.statuses.first&.tone || :neutral ])

  amount = row.amount.is_a?(BigDecimal) ? row.amount.to_s("F") : row.amount
  # The meta line below the title: what the read produced, when it produced it
  # (the type is always known, so it anchors the line). A held row states its
  # reason here instead — the tile explains itself.
  meta_parts = [ row.doc_type_label ]
  meta_parts << row.merchant if row.merchant.present?
  meta_parts << amount if amount.present?
  meta_parts << format_date(row.date) if row.date.present?
  meta = state == :needs_you ? row.failure_message : meta_parts.join(" · ")

  # object-top: a statement page is portrait, and the tile is 4:3 — the head of
  # the page carries the institution and the statement's own title, which is
  # what makes the document recognisable. A centred crop would show its middle.
  thumb = if row.thumb_url.present?
    image_tag(row.thumb_url, alt: row.title, loading: "lazy", class: "h-full w-full object-cover object-top")
  else
    content_tag(:div, icon(row.icon, size: "xl"),
                class: "flex h-full w-full items-center justify-center text-secondary",
                "aria-hidden": "true")
  end
%>
<%# A card (the Quicken Simplifi language, 2026-10-17): the thumbnail inset
    in a rounded container, the state pill in its corner, the title bold. %>
<div id="<%= row.key %>" class="flex flex-col gap-2.5 min-w-0 rounded-2xl bg-container p-2 shadow-border-xs" data-document-state="<%= state %>">
  <div class="relative aspect-[4/3] overflow-hidden rounded-xl bg-container-inset<%= " border border-dashed border-secondary" if state == :reading %>">
    <% if state == :reading %>
      <%# Nothing to show yet — the design's dashed box with the state centred. %>
      <div class="absolute inset-0 flex items-center justify-center">
        <%= render DS::Pill.new(label: state_label, tone: state_tone, marker: false) %>
      </div>
    <% else %>
      <% if row.viewer_url.present? %>
        <%= link_to row.viewer_url, data: { turbo_frame: "modal" }, class: "block h-full w-full", aria: { label: row.title } do %>
          <%= thumb %>
        <% end %>
      <% else %>
        <div class="h-full w-full"><%= thumb %></div>
      <% end %>
      <%# The status pill in the tile's corner (design D3). %>
      <span class="absolute left-2 top-2">
        <%= render DS::Pill.new(label: state_label, tone: state_tone, marker: false) %>
      </span>
    <% end %>
  </div>

  <div class="min-w-0 space-y-1 px-1 pb-1">
    <% if row.viewer_url.present? %>
      <%= link_to row.title, row.viewer_url, data: { turbo_frame: "modal" },
            class: "block truncate text-sm font-semibold text-primary" %>
    <% else %>
      <p class="truncate text-sm font-semibold text-primary"><%= row.title %></p>
    <% end %>
    <p class="<%= state == :needs_you ? "line-clamp-3 text-destructive" : "truncate text-secondary" %> text-xs">
      <%= meta %>
    </p>
    <%# The fix sits on the tile (spec §6): a held read offers its retries, and
        a statement with no account offers the picker. %>
    <% if state == :needs_you %>
      <%= render "documents/hold_actions", link: record, hold: record.hold_reason %>
    <% elsif state == :which_account && statement&.needs_account? %>
      <%# Computed once per page, not per tile; nil when no one is signed in. %>
      <% @tile_picker_accounts = Current.user&.accessible_accounts&.visible&.alphabetically&.to_a unless defined?(@tile_picker_accounts) %>
      <%= render "document_browser/account_picker", statement: statement, accounts: @tile_picker_accounts %>
    <% end %>
  </div>

  <%# The tile is purely visual (Milestone B, design D3): the document's
      affordances — Review details / Retry / Remove — moved into the viewer
      (Task 4), which every tile opens. Nothing is unreachable from here. %>
</div>
