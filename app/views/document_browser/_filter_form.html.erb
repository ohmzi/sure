<%# locals: (url:, filters:, source_filter:, documents:, tag_choices:) %>
<%= form_with url: url, method: :get, data: { controller: "auto-submit-form" },
      class: "flex flex-wrap items-center gap-2" do |form| %>
  <%# The source boxes stay top-level (`source[]`, the M7-pinned shape the
      wizard redirect writes); everything else rides in `q`. One GET form, so
      the facets compose by construction — no hidden field is needed (M8 Task 5
      records the deviation from M7 Task 10's separate search form). %>
  <% if documents %>
    <div class="flex flex-wrap items-center gap-3 rounded-lg border border-secondary px-3 py-2">
      <% DocumentLink::SOURCES.each do |source| %>
        <label class="flex items-center gap-1.5 text-sm text-primary">
          <%= check_box_tag "source[]", source, source_filter&.include?(source),
                class: "checkbox checkbox--light", data: { "auto-submit-form-target": "auto" } %>
          <%= t("documents.source.#{source}") %>
        </label>
      <% end %>
    </div>
  <% end %>

  <%# (repaired 2026-10-11, re-verifier: F9 residual) DS::SearchInput renders no
      id of its own, so the acceptance step's `find("#q_search")` cannot resolve -
      pin the id here (and the blur still goes through the auto-submit controller). %>
  <%= render DS::SearchInput.new(
        id: "q_search",
        name: "q[search]", value: filters[:search],
        placeholder: t("document_browser.filters.search_placeholder"),
        class: "grow max-w-xs",
        data: { "auto-submit-form-target": "auto" }) %>
  <%= select_tag "q[sort]",
        options_for_select(document_browser_sort_options, filters[:sort]),
        data: { "auto-submit-form-target": "auto" },
        class: "form-field__input w-auto" %>
  <%= date_field_tag "q[date_from]", filters[:date_from],
        data: { "auto-submit-form-target": "auto" },
        aria: { label: t("document_browser.filters.date_from") },
        autocomplete: "off",
        class: "form-field__input w-auto" %>
  <%= date_field_tag "q[date_to]", filters[:date_to],
        data: { "auto-submit-form-target": "auto" },
        aria: { label: t("document_browser.filters.date_to") },
        autocomplete: "off",
        class: "form-field__input w-auto" %>
<% end %>
