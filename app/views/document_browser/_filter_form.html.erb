<%# locals: (url:, filters:, active:, documents:, tag_choices:) %>
<%# The Documents redesign (2026-10-16, docs/superpowers/specs/2026-10-16-
    documents-intake-and-filters-design.md): phone first and Apple-like. The
    page keeps only a search row, the type switch and one chip per filter that
    is on; every facet lives in the Filters sheet, which applies on Show results
    (or Done) instead of on each tap. The field names are the ones the server
    has always read, so bookmarks and the search itself are untouched. %>
<%= form_with url: url, method: :get, data: { controller: "auto-submit-form" }, class: "space-y-3" do |form| %>
  <div class="flex items-center gap-2">
    <%# (repaired 2026-10-11, re-verifier: F9 residual) DS::SearchInput renders
        no id of its own; `#q_search` is pinned here. It submits on blur (the
        auto-submit controller) and on Enter. %>
    <%= render DS::SearchInput.new(
          variant: :filled,
          id: "q_search",
          name: "q[search]", value: filters[:search],
          placeholder: t("document_browser.filters.search_placeholder"),
          class: "grow lg:max-w-md",
          data: { "auto-submit-form-target": "auto" }) %>

    <button type="button"
            class="relative inline-flex items-center justify-center size-11 shrink-0 rounded-full border border-secondary bg-container text-link hover:bg-container-hover active:scale-95 transition focus-ring"
            aria-controls="document_filters_sheet" aria-haspopup="dialog"
            aria-label="<%= t("document_browser.filters.open_filters") %>"
            <%= tag.attributes(aria: { describedby: ("document_filters_count" if active.count.positive?) }) %>
            title="<%= t("document_browser.filters.open_filters") %>"
            data-controller="sheet-opener" data-sheet-opener-sheet-value="document_filters_sheet"
            data-action="sheet-opener#open">
      <%= icon("sliders-horizontal", size: "sm", color: "current") %>
      <% if active.count.positive? %>
        <span data-filter-count aria-hidden="true"
              class="absolute -top-1 -right-1 min-w-5 h-5 px-1 rounded-full bg-inverse text-inverse text-xs font-bold flex items-center justify-center"><%= active.count %></span>
        <span id="document_filters_count" class="sr-only"><%= t("document_browser.filters.active_count", count: active.count) %></span>
      <% end %>
    </button>
  </div>

  <% if documents %>
    <%# The type facet (Milestone B, design D1), now the iOS segmented control:
        each segment is a link to the same filters with that type, and its pill
        slides there as you tap. The hidden field carries the type through a
        search or Show results. "Receipts & Bills" is the comma-joined pair. %>
    <% selected_types = Array(filters[:type]).flat_map { |value| value.to_s.split(",") }.map(&:strip).select { |source| DocumentLink::SOURCES.include?(source) } %>
    <% current_type = if selected_types.include?("statement") then "statement"
                      elsif (selected_types & %w[receipt bill]).any? then "receipt,bill"
                      else ""
                      end %>
    <%= hidden_field_tag "q[type][]", current_type, id: nil if current_type.present? %>
    <%= render DS::SegmentedControl.new(sliding: true, full_width: true, aria_label: t("document_browser.filters.type"), class: "lg:max-w-md") do |control| %>
      <% [ [ "", t("document_browser.filters.types.all") ],
           [ "statement", t("document_browser.filters.types.statements") ],
           [ "receipt,bill", t("document_browser.filters.types.receipts_bills") ] ].each do |value, label| %>
        <% control.with_segment(label, href: active.type_url(value), active: current_type == value, class: "py-1.5") %>
      <% end %>
    <% end %>
  <% end %>

  <%# The "needs you" link's filter has no control in the sheet; this carries it
      through a search or Show results until its chip is removed. %>
  <%= hidden_field_tag "q[attention]", filters[:attention], id: nil if filters[:attention].present? %>

  <% if active.chips.any? %>
    <%# Chips wrap rather than scroll sideways (the owner, 2026-10-17). %>
    <nav aria-label="<%= t("document_browser.filters.chips.label") %>">
      <ul class="flex flex-wrap gap-2">
        <% active.chips.each do |chip| %>
          <li>
            <%= link_to chip.remove_url,
                  class: "inline-flex items-center gap-1 h-8 pl-3 pr-2 rounded-full border border-secondary bg-container hover:bg-container-hover text-link text-sm font-semibold whitespace-nowrap active:scale-95 transition focus-ring",
                  title: t("document_browser.filters.chips.remove", label: chip.label),
                  aria: { label: t("document_browser.filters.chips.remove", label: chip.label) } do %>
              <%= chip.label %>
              <%= icon("x", size: "xs", color: "current") %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </nav>
  <% end %>

  <%= render "document_browser/filter_sheet", active: active, filters: filters, documents: documents, tag_choices: tag_choices %>
<% end %>
