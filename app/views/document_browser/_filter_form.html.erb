<%# locals: (url:, filters:, source_filter:, documents:, tag_choices:) %>
<%= form_with url: url, method: :get, data: { controller: "auto-submit-form" },
      class: "flex flex-wrap items-center gap-2" do |form| %>
  <%# The source boxes stay top-level (`source[]`, the M7-pinned shape the
      wizard redirect writes); everything else rides in `q`. One GET form, so
      the facets compose by construction — no hidden field is needed (M8 Task 5
      records the deviation from M7 Task 10's separate search form). %>
  <% if documents %>
    <div class="flex flex-wrap items-center gap-3 rounded-lg border border-secondary px-3 py-2">
      <% DocumentLink::SOURCES.each do |source| %>
        <label class="flex items-center gap-1.5 text-sm text-primary">
          <%= check_box_tag "source[]", source, source_filter&.include?(source),
                class: "checkbox checkbox--light", data: { "auto-submit-form-target": "auto" } %>
          <%= t("documents.source.#{source}") %>
        </label>
      <% end %>
    </div>

    <%# The status facet (M8 Task 9, Ruling M8-L2): the row's own vocabulary —
        "show me what is still processing". %>
    <div class="flex flex-wrap items-center gap-3 rounded-lg border border-secondary px-3 py-2">
      <span class="text-sm text-secondary"><%= t("document_browser.filters.status") %></span>
      <% DocumentLink::STATUSES.each do |status| %>
        <label class="flex items-center gap-1.5 text-sm text-primary">
          <%= check_box_tag "q[status][]", status, Array(filters[:status]).include?(status),
                class: "checkbox checkbox--light", data: { "auto-submit-form-target": "auto" } %>
          <%= t("documents.status.#{status}") %>
        </label>
      <% end %>
    </div>
  <% else %>
    <%# The review / extraction facets (M8 Task 9, Ruling M8-L2; the query side
        landed with AccountStatement::Search in Task 3 — these are the controls
        the Close-out clause promised). %>
    <div class="flex flex-wrap items-center gap-3 rounded-lg border border-secondary px-3 py-2">
      <span class="text-sm text-secondary"><%= t("document_browser.filters.review") %></span>
      <% AccountStatement::Search::REVIEW_FILTERS.each do |review| %>
        <label class="flex items-center gap-1.5 text-sm text-primary">
          <%= check_box_tag "q[review][]", review, Array(filters[:review]).include?(review),
                class: "checkbox checkbox--light", data: { "auto-submit-form-target": "auto" } %>
          <%= t("account_statements.status.#{review}") %>
        </label>
      <% end %>
    </div>

    <div class="flex flex-wrap items-center gap-3 rounded-lg border border-secondary px-3 py-2">
      <span class="text-sm text-secondary"><%= t("document_browser.filters.extraction") %></span>
      <% AccountStatement::Search::EXTRACTION_FILTERS.each do |extraction| %>
        <label class="flex items-center gap-1.5 text-sm text-primary">
          <%= check_box_tag "q[extraction][]", extraction, Array(filters[:extraction]).include?(extraction),
                class: "checkbox checkbox--light", data: { "auto-submit-form-target": "auto" } %>
          <%= t("document_browser.filters.extraction_states.#{extraction}") %>
        </label>
      <% end %>
    </div>
  <% end %>

  <%# The Tags facet (M8 Task 6): the choices are the stored snapshot names, so
      the facet renders and filters locally (locked decisions 4/6).
      No tags stored yet renders the honest empty line, never a dead box. %>
  <div class="flex flex-wrap items-center gap-3 rounded-lg border border-secondary px-3 py-2">
    <span class="text-sm text-secondary"><%= t("document_browser.filters.tags") %></span>
    <% if tag_choices.any? %>
      <% tag_choices.each do |tag| %>
        <label class="flex items-center gap-1.5 text-sm text-primary">
          <%= check_box_tag "q[tags][]", tag, Array(filters[:tags]).include?(tag),
                class: "checkbox checkbox--light", data: { "auto-submit-form-target": "auto" } %>
          <%= tag %>
        </label>
      <% end %>
    <% else %>
      <span class="text-sm text-secondary"><%= t("document_browser.filters.no_tags") %></span>
    <% end %>
  </div>

  <%# The Merchant / Amount facet (M8 Task 7, locked decision 7). Documents
      read the understood draft's extracted payee/total; statements read the
      institution hint and carry no extracted total, so their amount fields are
      replaced by one honest note — the degradation is explicit, never silent. %>
  <div class="flex flex-wrap items-center gap-3 rounded-lg border border-secondary px-3 py-2">
    <span class="text-sm text-secondary">
      <%= documents ? t("document_browser.filters.merchant") : t("document_browser.filters.institution") %>
    </span>
    <%= text_field_tag "q[merchant]", filters[:merchant],
          placeholder: documents ? t("document_browser.filters.merchant_placeholder") : t("document_browser.filters.institution_placeholder"),
          autocomplete: "off",
          data: { "auto-submit-form-target": "auto" },
          aria: { label: documents ? t("document_browser.filters.merchant") : t("document_browser.filters.institution") },
          class: "form-field__input w-auto" %>
    <% if documents %>
      <%= number_field_tag "q[amount_min]", filters[:amount_min],
            placeholder: t("document_browser.filters.amount_min"),
            min: 0, step: "any",
            autocomplete: "off",
            data: { "auto-submit-form-target": "auto" },
            aria: { label: t("document_browser.filters.amount_min") },
            class: "form-field__input w-auto" %>
      <%= number_field_tag "q[amount_max]", filters[:amount_max],
            placeholder: t("document_browser.filters.amount_max"),
            min: 0, step: "any",
            autocomplete: "off",
            data: { "auto-submit-form-target": "auto" },
            aria: { label: t("document_browser.filters.amount_max") },
            class: "form-field__input w-auto" %>
    <% else %>
      <span class="text-sm text-secondary"><%= t("document_browser.filters.statements_amount_note") %></span>
    <% end %>
  </div>

  <%# (repaired 2026-10-11, re-verifier: F9 residual) DS::SearchInput renders no
      id of its own, so the acceptance step's `find("#q_search")` cannot resolve -
      pin the id here (and the blur still goes through the auto-submit controller). %>
  <%= render DS::SearchInput.new(
        id: "q_search",
        name: "q[search]", value: filters[:search],
        placeholder: t("document_browser.filters.search_placeholder"),
        class: "grow max-w-xs",
        data: { "auto-submit-form-target": "auto" }) %>
  <%= select_tag "q[sort]",
        options_for_select(document_browser_sort_options, filters[:sort]),
        data: { "auto-submit-form-target": "auto" },
        class: "form-field__input w-auto" %>
  <%= date_field_tag "q[date_from]", filters[:date_from],
        data: { "auto-submit-form-target": "auto" },
        aria: { label: t("document_browser.filters.date_from") },
        autocomplete: "off",
        class: "form-field__input w-auto" %>
  <%= date_field_tag "q[date_to]", filters[:date_to],
        data: { "auto-submit-form-target": "auto" },
        aria: { label: t("document_browser.filters.date_to") },
        autocomplete: "off",
        class: "form-field__input w-auto" %>
<% end %>
