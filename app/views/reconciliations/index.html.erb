<% content_for :title, t(".title") %>

<div class="space-y-4">
  <% if @links.empty? %>
    <%= render DS::EmptyState.new(icon: "receipt-text", title: t(".empty_title"), description: t(".empty_description")) %>
  <% else %>
    <%= render partial: "result", collection: @links, as: :link, locals: { results: @results } %>
  <% end %>
</div>
