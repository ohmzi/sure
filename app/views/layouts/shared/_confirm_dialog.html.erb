<%# This dialog is used as an override to the browser's confirm API when submitting forms with data-turbo-confirm %>
<%# See confirm_dialog_controller.js and _htmldoc.html.erb  %>
<%# V2 (2026-10-19): centred, as iOS asks — an icon on a tinted tile (red
    when the action destroys something, popups.css), a bold question, what
    it means, then the action as a tall pill with Cancel under it. %>
<%= render DS::Dialog.new(id: "confirm-dialog", auto_open: false, data: { controller: "confirm-dialog" }, width: "sm", disable_frame: true) do |dialog| %>
  <% dialog.with_body do %>
    <form method="dialog" class="flex flex-col items-center gap-2 pt-2 text-center">
      <span class="confirm-dialog__icon mb-2 flex size-[60px] items-center justify-center rounded-[20px] bg-link/10 text-link" aria-hidden="true">
        <%= icon("circle-alert", size: "xl", color: "current") %>
      </span>

      <h3 class="text-2xl font-extrabold tracking-tight text-primary" data-confirm-dialog-target="title"><%= t(".are_you_sure") %></h3>
      <p class="text-[15px] leading-snug text-secondary" data-confirm-dialog-target="subtitle"><%= t(".cannot_be_undone") %></p>

      <div class="w-full space-y-1 pt-4">
        <% ["primary", "outline-destructive", "destructive"].each do |variant| %>
          <%= render DS::Button.new(
          text: t(".confirm"),
          variant: variant,
          type: :submit,
          autofocus: true,
          full_width: true,
          value: "confirm",
          data: { variant: variant, confirm_dialog_target: "confirmButton" },
          hidden: true,
        ) %>
        <% end %>

        <button type="submit" value="cancel" class="press flex h-12 w-full items-center justify-center rounded-full text-[17px] font-bold text-link hover:bg-surface-inset focus-ring">
          <%= t(".cancel") %>
        </button>
      </div>
    </form>
  <% end %>
<% end %>
