<%# locals: (intro_mode:, home_path:) %>
<%# The phone's toolbar, the same on every page (the owner, 2026-10-19):
    insights, the logo, privacy and your menu. It floats over the page,
    translucent and blurred, with a soft fade under it, so the page scrolls
    beneath it rather than being cut off at a hard edge; the page's own large
    title comes next. --app-toolbar-h on the scrolling area is its height,
    for sticky headers and scrolled-to anchors to sit under it. The blur is
    on a layer behind the content, not on the bar: a filter on the bar would
    make it the box its fixed children are placed in, and the account menu's
    bottom sheet would open above the screen instead of at its foot. %>
<nav class="lg:hidden fixed inset-x-0 top-0 z-30 flex justify-between items-center p-3 pt-[calc(env(safe-area-inset-top)+0.75rem)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-surface/70 backdrop-blur-xl backdrop-saturate-150"></div>
  <% if intro_mode %>
  <% else %>
    <div class="flex items-center gap-1">
      <%= render "layouts/shared/insights_button" %>
    </div>
  <% end %>

  <%= link_to home_path, class: "absolute left-1/2 -translate-x-1/2" do %>
    <%= image_tag "logomark-color.svg", class: "w-9 h-9 mx-auto" %>
  <% end %>

  <div class="flex items-center gap-1">
    <button type="button"
            class="inline-flex items-center justify-center w-9 h-9 pointer-coarse:w-11 pointer-coarse:h-11 rounded-lg text-secondary hover:text-primary hover:bg-container-inset-hover transition-colors focus-ring"
            data-action="click->privacy-mode#toggle"
            data-privacy-mode-target="toggle"
            title="<%= t("layouts.application.privacy_mode") %>"
            aria-label="<%= t("layouts.application.privacy_mode") %>"
            aria-pressed="false">
      <%= icon("eye-off", size: "sm", data: { privacy_mode_target: "iconOff" }) %>
      <%= icon("eye", size: "sm", class: "hidden", data: { privacy_mode_target: "iconOn" }) %>
    </button>
    <%= render "users/user_menu", user: Current.user, placement: "bottom-end", offset: 12, intro_mode: intro_mode %>
  </div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-full h-6 bg-linear-to-b from-surface/70 to-transparent"></div>
</nav>
