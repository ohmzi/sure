<%# Settings, redesigned as an Apple app would (the owner, 2026-10-17). On a
    phone every page has the app's toolbar and then its large title, and the
    tab bar with More picked, like any other page (2026-10-19: no back bar). On a computer it is
    two panes, like System Settings: the list on the left, the page on the
    right. No breadcrumbs, no tab strip, no next/previous footer. %>
<% intro_mode = Current.user&.ui_layout_intro? %>
<%= render "layouts/shared/htmldoc", sidebar_aware: true do %>
  <div class="flex h-full bg-surface lg:pt-[env(safe-area-inset-top)]" data-controller="privacy-mode">
    <%= render "layouts/shared/mobile_toolbar", intro_mode: intro_mode, home_path: intro_mode ? chats_path : root_path %>
    <%= link_to t("layouts.application.skip_to_main"), "#main",
        class: "sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-2 focus:rounded-lg focus:bg-container focus:text-primary focus:shadow-border-xs" %>

    <aside id="settings-nav-container" data-controller="preserve-scroll"
           class="hidden lg:block w-96 shrink-0 h-full overflow-y-auto border-r border-divider px-5 pb-10">
      <div class="sticky top-0 z-10 -mx-5 px-5 pt-5 pb-4 bg-surface/85 backdrop-blur-xl">
        <%= link_to previous_path, class: "inline-flex items-center gap-1 text-base text-link rounded-md focus-ring",
              data: { controller: "hotkey", hotkey: "Escape" } do %>
          <%= icon("chevron-left", size: "sm", color: "current") %><%= t("layouts.settings.back_to_app") %>
        <% end %>
        <h1 class="mt-3 text-3xl font-bold tracking-tight text-primary"><%= t("layouts.settings.title") %></h1>
      </div>
      <%= render "settings/settings_nav" %>
    </aside>

    <main id="main" class="settings-page app-scroller grow min-w-0 h-full overflow-y-auto overscroll-contain" data-controller="settings-scroll" data-notification-tray-target="main">
      <div class="max-w-5xl mx-auto px-4 lg:px-10 pb-[calc(6rem+env(safe-area-inset-bottom))] lg:pb-12">
        <% if content_for?(:page_title) || content_for?(:page_actions) %>
          <%# The actions sit on the title's row, as iOS puts a page's buttons
              beside its large title (2026-10-19), and wrap under it only when
              the title leaves no room ("Recurring Transactions"). %>
          <header class="flex flex-wrap items-center justify-between gap-x-3 gap-y-3 pt-2 lg:pt-10 pb-5">
            <h1 class="min-w-0 text-3xl font-bold tracking-tight text-primary"><%= content_for :page_title %></h1>
            <% if content_for?(:page_actions) %>
              <div class="flex flex-wrap items-center gap-2 shrink-0"><%= yield :page_actions %></div>
            <% end %>
          </header>
        <% end %>

        <div class="space-y-6">
          <%= yield :system_alerts %>
          <%= yield %>
        </div>
      </div>
    </main>
    <%= render "layouts/shared/mobile_tab_bar", items: app_tab_items(intro_mode: intro_mode, selected: :more) %>
  </div>
<% end %>
