<%# locals: (pagy:) %>
<%# The page changer, modernised (the owner, 2026-10-18), everywhere a list
    pages: round previous/next buttons either side of the page numbers in one
    pill track (the current page in brand colour), what is showing ("51–100 of
    1,302"), and the page size as a pill. On a phone the numbers keep the
    first, current and last page (PaginationHelper#pagination_mobile_plan);
    the track scrolls rather than wraps if a column is too narrow even for
    those. Every link visits the whole page, which lands at its top. %>
<% series = pagy.series %>
<% mobile_plan = pagination_mobile_plan(series) %>
<% step_classes = "press inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-container text-primary shadow-border-xs hover:bg-container-hover transition-colors focus-ring" %>
<%# Room below on a phone, so the floating + never sits on the page size. %>
<nav aria-label="<%= t("shared.pagination.label") %>" class="flex w-full flex-col gap-3 pb-20 lg:pb-0 sm:flex-row sm:items-center sm:justify-between">
  <div class="flex min-w-0 items-center gap-2">
    <% if pagy.prev %>
      <%= link_to pagy_url_for(pagy, pagy.prev), data: { turbo_frame: :_top }, class: step_classes, aria: { label: t("shared.pagination.previous") } do %>
        <%= icon("chevron-left", color: "current") %>
      <% end %>
    <% else %>
      <span class="<%= step_classes %> opacity-40" aria-hidden="true"><%= icon("chevron-left", color: "current") %></span>
    <% end %>

    <div class="flex min-w-0 max-w-full flex-nowrap items-center gap-0.5 overflow-x-auto no-scrollbar rounded-full bg-surface-inset p-1">
      <% series.each_with_index do |series_item, index| %>
        <% mobile_state = mobile_plan[index] %>
        <%# Stands in for the run of pages hidden from here on a phone. %>
        <% if mobile_state == :collapsed %>
          <span class="inline-flex sm:hidden h-8 shrink-0 items-center px-1.5 text-sm font-semibold text-subdued" aria-hidden="true">…</span>
        <% end %>
        <% if series_item.is_a?(Integer) %>
          <%= link_to series_item, pagy_url_for(pagy, series_item),
                data: { turbo_frame: :_top },
                aria: { label: t("shared.pagination.page", page: series_item) },
                class: class_names("press h-8 min-w-8 shrink-0 items-center justify-center rounded-full px-2.5 text-sm font-semibold tabular text-secondary hover:bg-container hover:text-primary transition-colors focus-ring",
                                   mobile_state == :visible ? "inline-flex" : "hidden sm:inline-flex") %>
        <% elsif series_item.is_a?(String) %>
          <%= link_to series_item, pagy_url_for(pagy, series_item),
                data: { turbo_frame: :_top },
                aria: { current: "page", label: t("shared.pagination.page", page: series_item) },
                class: "pop-in inline-flex h-8 min-w-8 shrink-0 items-center justify-center rounded-full bg-inverse px-2.5 text-sm font-bold tabular text-inverse shadow-[0_6px_14px_-8px_var(--color-link)] focus-ring" %>
        <% elsif series_item == :gap %>
          <span class="inline-flex h-8 shrink-0 items-center px-1.5 text-sm font-semibold text-subdued">…</span>
        <% end %>
      <% end %>
    </div>

    <% if pagy.next %>
      <%= link_to pagy_url_for(pagy, pagy.next), data: { turbo_frame: :_top }, class: step_classes, aria: { label: t("shared.pagination.next") } do %>
        <%= icon("chevron-right", color: "current") %>
      <% end %>
    <% else %>
      <span class="<%= step_classes %> opacity-40" aria-hidden="true"><%= icon("chevron-right", color: "current") %></span>
    <% end %>
  </div>

  <div class="flex items-center justify-between gap-3 sm:justify-end">
    <% if pagy.count.positive? %>
      <p class="text-xs font-medium text-secondary tabular"><%= t("shared.pagination.showing", from: number_with_delimiter(pagy.from), to: number_with_delimiter(pagy.to), count: number_with_delimiter(pagy.count)) %></p>
    <% end %>
    <label class="relative inline-flex items-center">
      <span class="sr-only"><%= t("shared.pagination.page_size") %></span>
      <%= select_tag :per_page,
                     options_for_select(%w[10 20 30 50 100].map { |size| [ t("shared.pagination.per_page", count: size), size ] }, pagy.limit.to_s),
                     data: { controller: "selectable-link" },
                     class: "press h-10 appearance-none rounded-full border-0 bg-container pl-4 pr-9 text-sm font-semibold text-primary shadow-border-xs cursor-pointer focus:ring-2 focus:ring-link" %>
    </label>
  </div>
</nav>
