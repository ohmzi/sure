<%# locals: (outflows_data:, period:, card_accounts: [], selected_card: nil) %>
<div id="outflows-donut-section" class="@container">
  <div class="px-4">
    <% if card_accounts.size > 1 %>
      <div class="pb-2 flex items-center justify-end">
        <%= form_with url: root_path, method: :get, data: { controller: "auto-submit-form" }, class: "flex items-center gap-2" do |form| %>
          <% request.query_parameters.except("card_account_id").each do |key, value| %>
            <%= hidden_field_tag key, value %>
          <% end %>
          <%= form.select :card_account_id,
                          card_accounts.map { |account| [ account.name, account.id ] },
                          { selected: selected_card&.id },
                          class: "bg-container border border-secondary rounded-lg px-3 py-2 text-sm pr-7 cursor-pointer text-primary focus:outline-hidden focus:ring-0",
                          data: { "auto-submit-form-target": "auto" },
                          aria: { label: t("pages.dashboard.outflows_donut.card_label") } %>
        <% end %>
      </div>
    <% end %>

    <% if outflows_data[:categories].empty? %>
      <p class="py-8 text-center text-sm text-secondary"><%= t("pages.dashboard.outflows_donut.empty") %></p>
    <% else %>
    <%# Tapping a category, on the ring or in the list, picks it: the list
        turns into that category's latest charges, with "See all" opening
        them in Activity, rather than leaving for Activity at once. The
        chip's ✕, or picking it again, lets it go (the owner, 2026-10-18). %>
    <div class="flex flex-col @2xl:flex-row gap-8 items-center"
      data-controller="donut-chart breakdown-focus"
      data-action="donut-chart:select->breakdown-focus#select donut-chart:clear->breakdown-focus#clear"
      data-donut-chart-selectable-value="true"
      data-donut-chart-segments-value="<%= outflows_data[:categories].to_json %>"
      data-donut-chart-segment-opacity-value="0.9"
      data-donut-chart-extended-hover-value="true"
      data-donut-chart-hover-extension-value="3"
      data-donut-chart-start-date-value="<%= period.date_range.first %>"
      data-donut-chart-end-date-value="<%= period.date_range.last %>">
      <!-- Donut Chart -->
      <div class="w-full @2xl:w-1/3 max-w-[300px] px-4">
        <div class="h-[300px] relative">
          <div data-donut-chart-target="chartContainer" class="absolute inset-0 pointer-events-none"></div>

          <div data-donut-chart-target="contentContainer" class="flex justify-center items-center h-full">
            <%# The same three lines as a picked slice's (name, amount, share),
                so the label and amount hold still when one is picked (the
                owner, 2026-10-18). %>
            <div data-donut-chart-target="defaultContent" class="flex flex-col gap-2 items-center">
              <p class="text-sm text-secondary"><%= selected_card ? t("pages.dashboard.outflows_donut.total_charges") : t("pages.dashboard.outflows_donut.total_outflows") %></p>

              <p data-donut-chart-target="amount" class="text-3xl h-9 leading-9 font-bold tracking-tight text-primary privacy-sensitive whitespace-nowrap">
                <%= format_money Money.new(outflows_data[:total], outflows_data[:currency]) %>
              </p>

              <p class="text-sm text-secondary"><%= t("pages.dashboard.outflows_donut.category_count", count: outflows_data[:categories].count) %></p>
            </div>

            <% outflows_data[:categories].each do |category| %>
              <div id="segment_<%= category[:id] %>" class="hidden">
                <div class="flex flex-col gap-2 items-center">
                  <p class="max-w-44 truncate text-center text-sm text-secondary" title="<%= category[:name] %>"><%= category[:name] %></p>

                  <p data-donut-chart-target="amount" class="text-3xl h-9 leading-9 font-bold tracking-tight text-primary privacy-sensitive whitespace-nowrap">
                    <%= format_money Money.new(category[:amount], outflows_data[:currency]) %>
                  </p>

                  <p class="text-sm text-secondary privacy-sensitive"><%= category[:percentage] %>%</p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Category List -->
      <div class="w-full @2xl:w-2/3 overflow-x-auto">
        <%= render "pages/dashboard/breakdown_focus_detail", frame_id: "outflows_donut_transactions",
                                                             reset_label: t("pages.dashboard.outflows_donut.show_all_categories") %>

        <div class="space-y-1 fade-in" data-breakdown-focus-target="list">
        <div class="px-3 sm:px-4 py-2 flex items-center uppercase text-xs font-medium text-secondary">
          <div class="w-16 @2xl:w-40">
            <p><%= t("pages.dashboard.outflows_donut.categories") %><span class="text-subdued mx-1">&middot;</span><%= outflows_data[:categories].count %></p>
          </div>
          <div class="ml-auto text-right flex items-center gap-6">
            <div class="w-16 @2xl:w-40">
              <p><%= t("pages.dashboard.outflows_donut.value") %></p>
            </div>
            <div class="w-16">
              <p><%= t("pages.dashboard.outflows_donut.weight") %></p>
            </div>
          </div>
        </div>
        <div class="border-t border-subdued divide-y divide-subdued font-medium text-sm max-w-full">
          <% outflows_data[:categories].each_with_index do |category, idx| %>
            <%
              category_content = capture do
            %>
              <div class="flex items-center gap-3 flex-1 min-w-0">
                <div class="h-7 w-7 flex-shrink-0 group-hover:scale-105 transition-all duration-300 rounded-full flex justify-center items-center"
                  style="
                    background-color: color-mix(in oklab, <%= category[:color] %> 10%, transparent);
                    border-color: color-mix(in oklab, <%= category[:color] %> 10%, transparent);
                    color: <%= category[:color] %>;">
                  <% if category[:icon] %>
                    <%= icon(category[:icon], color: "current", size: "sm") %>
                  <% else %>
                    <%= render DS::FilledIcon.new(
                      variant: :text,
                      hex_color: category[:color],
                      text: category[:name],
                      size: "sm",
                      rounded: true
                    ) %>
                  <% end %>
                </div>
                <span class="text-sm font-medium text-primary truncate"><%= category[:name] %></span>
              </div>
              <div class="flex items-center gap-4 flex-shrink-0 text-right">
                <span class="text-sm font-medium text-primary whitespace-nowrap privacy-sensitive"><%= format_money Money.new(category[:amount], category[:currency]) %></span>
                <span class="text-sm text-secondary whitespace-nowrap w-10 @2xl:w-15 privacy-sensitive"><%= category[:percentage] %>%</span>
              </div>
            <% end %>

            <% if category[:clickable] != false %>
              <% category_query = { categories: [ category[:filter_value] ], start_date: period.date_range.first, end_date: period.date_range.last } %>
              <% category_query[:account_ids] = [ selected_card.id ] if selected_card %>
              <%= link_to transactions_path(q: category_query),
                  class: "flex items-center justify-between px-3 sm:px-4 py-3 cursor-pointer group gap-3 hover:bg-container-hover transition-colors press",
                  data: {
                    turbo_frame: "_top",
                    turbo_prefetch: false,
                    category_id: category[:id],
                    preview_url: dashboard_merchant_transactions_path(q: category_query, frame: "outflows_donut_transactions"),
                    preview_title: category[:name],
                    preview_color: category[:color],
                    action: "click->donut-chart#pick pointerenter->donut-chart#highlightSegment pointerleave->donut-chart#unhighlightSegment"
                  } do %>
                <%= category_content %>
              <% end %>
            <% else %>
              <div class="flex items-center justify-between px-3 sm:px-4 py-3 group gap-3"
                  data-category-id="<%= category[:id] %>"
                  data-action="pointerenter->donut-chart#highlightSegment pointerleave->donut-chart#unhighlightSegment">
                <%= category_content %>
              </div>
            <% end %>
          <% end %>
        </div>
        </div>
      </div>
    </div>
    <%# The row closes inside the branch that opened it: closing it after the
        `end` closed an extra element on an empty card, which ended the
        dashboard's grid early and left every later widget with no gap. %>
    <% end %>
  </div>
</div>
