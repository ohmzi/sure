<%# locals: (breakdown:, period:, selected_category:, category_options:) %>
<%= turbo_frame_tag "dashboard_merchant_breakdown" do %>
  <div id="merchant-breakdown-section" class="@container">
    <div class="px-4">
      <div class="pb-2 flex items-center justify-end">
        <%= form_with url: dashboard_merchant_breakdown_path, method: :get,
              data: { controller: "auto-submit-form", turbo_frame: "dashboard_merchant_breakdown" },
              class: "flex items-center gap-2" do |form| %>
          <%= hidden_field_tag :start_date, period.date_range.first %>
          <%= hidden_field_tag :end_date, period.date_range.last %>
          <%= form.select :category_id,
                          category_options,
                          { selected: selected_category&.id },
                          class: "bg-container border border-secondary rounded-lg px-3 py-2 text-sm pr-7 cursor-pointer text-primary focus:outline-hidden focus:ring-0",
                          data: { "auto-submit-form-target": "auto" },
                          aria: { label: t(".category_label") } %>
        <% end %>
      </div>

      <% if breakdown.nil? || (breakdown.rows.empty? && breakdown.refunds.empty?) %>
        <p class="py-8 text-center text-sm text-secondary"><%= t(".empty") %></p>
      <% else %>
        <% if breakdown.rows.any? || breakdown.refunds.any? %>
        <% all_rows = breakdown.rows + breakdown.refunds %>
        <% segments = all_rows.map { |row| { id: row.id, amount: row.amount.to_f, color: row.color } } %>
        <%# A tapped merchant stays picked, and the list under the ring turns
            into its latest transactions with a way to all of them; "All
            merchants" puts both back (the owner, 2026-10-18). %>
        <div class="flex flex-col @2xl:flex-row gap-8 items-center"
          data-controller="donut-chart breakdown-focus"
          data-action="donut-chart:select->breakdown-focus#select donut-chart:clear->breakdown-focus#clear"
          data-donut-chart-selectable-value="true"
          data-donut-chart-segments-value="<%= segments.to_json %>"
          data-donut-chart-segment-opacity-value="0.9"
          data-donut-chart-extended-hover-value="true"
          data-donut-chart-hover-extension-value="3"
          data-donut-chart-enable-click-value="false"
          data-donut-chart-start-date-value="<%= period.date_range.first %>"
          data-donut-chart-end-date-value="<%= period.date_range.last %>">
          <div class="w-full @2xl:w-1/3 max-w-[300px] px-4">
            <div class="h-[300px] relative">
              <div data-donut-chart-target="chartContainer" class="absolute inset-0 pointer-events-none"></div>

              <div data-donut-chart-target="contentContainer" class="flex justify-center items-center h-full">
                <div data-donut-chart-target="defaultContent" class="flex flex-col items-center">
                  <div class="text-secondary text-sm mb-2">
                    <span><%= t(".net_#{breakdown.direction}") %></span>
                  </div>

                  <div data-donut-chart-target="amount" class="text-3xl font-bold tracking-tight text-primary privacy-sensitive whitespace-nowrap">
                    <%= format_money Money.new(breakdown.net_total, breakdown.currency) %>
                  </div>
                </div>

                <% all_rows.each do |row| %>
                  <div id="segment_<%= row.id %>" class="hidden">
                    <div class="flex flex-col gap-2 items-center">
                      <p class="text-sm text-secondary"><%= row.negative ? t(".refund_label", name: row.name) : row.name %></p>

                      <p data-donut-chart-target="amount" class="text-3xl font-bold tracking-tight text-primary privacy-sensitive whitespace-nowrap">
                        <%= "-" if row.negative %><%= format_money Money.new(row.amount, breakdown.currency) %>
                      </p>

                      <p class="text-sm text-secondary privacy-sensitive"><%= row.percentage %>%</p>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <div class="w-full @2xl:w-2/3 overflow-x-auto">
            <div hidden data-breakdown-focus-target="detail">
              <div class="px-4 py-2 flex items-center justify-between gap-3">
                <p class="min-w-0 truncate text-xs font-medium uppercase text-secondary" data-breakdown-focus-target="title"></p>
                <button type="button" data-action="donut-chart#reset"
                        class="press inline-flex h-9 shrink-0 items-center gap-1.5 rounded-full bg-container-inset px-3.5 text-sm font-semibold text-primary hover:bg-container-inset-hover transition-colors focus-ring">
                  <%= icon("rotate-ccw", size: "sm", color: "current") %>
                  <%= t(".all_merchants") %>
                </button>
              </div>
              <%= turbo_frame_tag "merchant_breakdown_transactions", class: "block border-t border-subdued pt-1" do %>
                <div class="space-y-2 p-3" aria-hidden="true">
                  <div class="shimmer h-10 rounded-lg"></div>
                  <div class="shimmer h-10 rounded-lg"></div>
                  <div class="shimmer h-10 rounded-lg"></div>
                </div>
              <% end %>
            </div>

            <div class="space-y-1" data-breakdown-focus-target="list">
            <div class="px-4 py-2 flex items-center uppercase text-xs font-medium text-secondary">
              <div class="w-16 @2xl:w-40">
                <p><%= t(".merchants") %><span class="text-subdued mx-1">&middot;</span><%= breakdown.rows.count %></p>
              </div>
              <div class="ml-auto text-right flex items-center gap-6">
                <div class="w-16 @2xl:w-40">
                  <p><%= t(".value") %></p>
                </div>
                <div class="w-16">
                  <p><%= t(".weight") %></p>
                </div>
              </div>
            </div>

            <div class="py-1 border-t border-subdued font-medium text-sm max-w-full">
              <% breakdown.rows.each_with_index do |row, idx| %>
                <% row_content = capture do %>
                  <div class="flex items-center gap-3 flex-1 min-w-0">
                    <div class="h-7 w-7 flex-shrink-0 group-hover:scale-105 transition-all duration-300 rounded-full flex justify-center items-center"
                      style="background-color: color-mix(in oklab, <%= row.color %> 10%, transparent); color: <%= row.color %>;">
                      <% if row.logo_url.present? %>
                        <%= image_tag Setting.transform_brand_fetch_url(row.logo_url),
                                      class: "h-5 w-5 rounded-full", loading: "lazy", alt: "" %>
                      <% else %>
                        <%= render DS::FilledIcon.new(
                          variant: :text,
                          hex_color: row.color,
                          text: row.name,
                          size: "sm",
                          rounded: true
                        ) %>
                      <% end %>
                    </div>
                    <span class="text-sm font-medium text-primary truncate"><%= row.name %></span>
                  </div>
                  <div class="flex items-center gap-4 flex-shrink-0 text-right">
                    <span class="text-sm font-medium text-primary whitespace-nowrap privacy-sensitive"><%= format_money Money.new(row.amount, breakdown.currency) %></span>
                    <span class="text-sm text-secondary whitespace-nowrap w-10 @2xl:w-15 privacy-sensitive"><%= row.percentage %>%</span>
                  </div>
                <% end %>

                <% query = { categories: [ selected_category.filter_value ],
                             start_date: period.date_range.first,
                             end_date: period.date_range.last } %>
                <% if row.merchant_id.present? %>
                  <% query[:merchants] = [ row.merchant_name ] %>
                <% else %>
                  <% query[:search] = row.name %>
                <% end %>
                <%= link_to transactions_path(q: query),
                    class: "flex items-center justify-between mx-3 p-3 rounded-lg cursor-pointer group gap-3 hover:bg-container-inset-hover transition-colors press",
                    data: {
                      turbo_frame: "_top",
                      turbo_prefetch: false,
                      category_id: row.id,
                      preview_url: dashboard_merchant_transactions_path(q: query),
                      preview_title: row.name,
                      action: "mouseenter->donut-chart#highlightSegment mouseleave->donut-chart#unhighlightSegment"
                    } do %>
                  <%= row_content %>
                <% end %>

                <% if idx < breakdown.rows.size - 1 %>
                  <%= render "shared/ruler", classes: "mx-3 @2xl:mx-4" %>
                <% end %>
              <% end %>
            </div>

            <%# The category's refunds and credits, flat under its merchants
                as money back — green, with a plus — rather than a box of
                their own, then the net (the owner, 2026-10-18). A picked
                merchant's preview shows that merchant's own refunds instead.
                Each row can be picked on the ring like a merchant. %>
            <% if breakdown.refunds.any? %>
              <div class="mt-3 px-4 py-2 flex items-center justify-between gap-3 text-xs font-medium uppercase text-secondary border-b border-subdued">
                <p class="flex items-center gap-1.5">
                  <%= icon("undo-2", size: "xs", color: "current") %>
                  <%= t(".refunds") %><span class="text-subdued">&middot;</span><%= breakdown.refunds.count %>
                </p>
                <p class="text-success normal-case text-sm font-semibold privacy-sensitive tabular">+<%= format_money Money.new(breakdown.refunds.sum(&:amount), breakdown.currency) %></p>
              </div>

              <div class="py-1 font-medium text-sm max-w-full">
                <% breakdown.refunds.each_with_index do |row, idx| %>
                  <% query = { categories: [ selected_category.filter_value ],
                               start_date: period.date_range.first,
                               end_date: period.date_range.last } %>
                  <% if row.merchant_id.present? %>
                    <% query[:merchants] = [ row.merchant_name ] %>
                  <% else %>
                    <% query[:search] = row.name %>
                  <% end %>
                  <%= link_to transactions_path(q: query),
                      class: "flex items-center justify-between mx-3 p-3 rounded-lg cursor-pointer group gap-3 hover:bg-container-inset-hover transition-colors press",
                      data: {
                        turbo_frame: "_top",
                        turbo_prefetch: false,
                        refund_row: true,
                        category_id: row.id,
                        preview_url: dashboard_merchant_transactions_path(q: query),
                        preview_title: row.name,
                        action: "mouseenter->donut-chart#highlightSegment mouseleave->donut-chart#unhighlightSegment"
                      } do %>
                    <div class="flex items-center gap-3 flex-1 min-w-0">
                      <div class="h-7 w-7 flex-shrink-0 rounded-full flex justify-center items-center bg-success/10 text-success">
                        <%= icon("undo-2", size: "sm", color: "current") %>
                      </div>
                      <span class="text-sm font-medium text-primary truncate"><%= row.name %></span>
                    </div>
                    <div class="flex items-center gap-4 flex-shrink-0 text-right">
                      <span class="text-sm font-medium text-success whitespace-nowrap privacy-sensitive">+<%= format_money Money.new(row.amount, breakdown.currency) %></span>
                      <span class="text-sm text-secondary whitespace-nowrap w-10 @2xl:w-15 privacy-sensitive"><%= row.percentage %>%</span>
                    </div>
                  <% end %>

                  <% if idx < breakdown.refunds.size - 1 %>
                    <%= render "shared/ruler", classes: "mx-3 @2xl:mx-4" %>
                  <% end %>
                <% end %>
              </div>

              <div class="mx-3 flex items-center justify-between gap-3 border-t border-primary p-3 text-sm">
                <span class="text-secondary"><%= t(".net_after_refunds") %></span>
                <span class="font-semibold text-primary privacy-sensitive tabular"><%= format_money Money.new(breakdown.net_total, breakdown.currency) %></span>
              </div>
            <% end %>
            </div>
          </div>
        </div>
        <% end %>

      <% end %>
    </div>
  </div>
<% end %>
