<%# locals: (balance_sheet:, period:, **args) %>

<%# Sliding a finger (or the pointer) along the line moves the figure to
    that day and names it; letting go rolls back (the owner, 2026-10-18). %>
<div id="net-worth-chart"
     data-controller="scrub-readout"
     data-action="time-series-chart:scrub->scrub-readout#show time-series-chart:release->scrub-readout#reset">
  <% series = balance_sheet.net_worth_series(period: period) %>
  <div class="flex justify-between gap-4 px-4">
    <div class="space-y-2">
      <% if series.trend.present? %>
        <p class="text-sm font-medium text-secondary" data-scrub-readout-target="label"><%= period.label %></p>
        <%# While syncing, a small glowing dot beside the figure rather than the
            figure itself pulsing (the animation pass, 2026-10-18). %>
        <p class="text-primary text-4xl font-bold tracking-tight flex items-center gap-3">
          <span class="privacy-sensitive tabular" data-scrub-readout-target="value"><%= series.trend.current.format %></span>
          <% if balance_sheet.syncing? %>
            <span class="relative inline-flex size-2.5" aria-hidden="true">
              <span class="ping absolute inset-0 rounded-full bg-inverse"></span>
              <span class="relative size-2.5 rounded-full bg-inverse"></span>
            </span>
          <% end %>
        </p>
        <div class="transition-opacity" data-scrub-readout-target="hide">
          <%= render partial: "shared/trend_change", locals: { trend: series.trend, comparison_label: period.comparison_label } %>
        </div>
      <% else %>
        <p class="text-sm text-secondary"><%= t(".data_not_available") %></p>
      <% end %>
    </div>
  </div>

  <% if series.any? %>
    <div
    id="netWorthChart"
    class="w-full min-h-52 privacy-sensitive"
    style="height: var(--dash-widget-h, 13rem);"
    data-controller="time-series-chart"
    data-time-series-chart-data-value="<%= series.to_json %>"
    data-time-series-chart-selectable-value="true"
    draggable="false"></div>
  <% else %>
    <div class="w-full h-full flex items-center justify-center">
      <p class="text-secondary text-sm"><%= t(".data_not_available") %></p>
    </div>
  <% end %>

</div>
