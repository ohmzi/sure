<%# locals: (entry:, transaction:, variant: :desktop) %>

<%# Always mounted, even without tags, so the toggle stream can fill in the
    first tag. The mobile slot hides itself while the summary is empty
    (touch has no hover affordance to show). %>
<div class="w-full min-w-0">
  <% if transaction.transfer? || !can_annotate_account?(entry.account) %>
    <%# Read-only: transfer tags must stay in sync across both legs (edit them
        from the drawer), and read-only shares can't change tags at all. %>
    <%= render "tags/summary", transaction: transaction, variant: variant, editable: false %>
  <% else %>
    <%= render DS::Popover.new(variant: "button", aria_label: t(".label")) do |popover| %>
      <% popover.with_button(class: "flex w-full min-w-0 items-center") do %>
        <%= render "tags/summary", transaction: transaction, variant: variant %>
      <% end %>

      <% popover.with_custom_content do %>
        <%= turbo_frame_tag "tag_dropdown", src: tag_dropdown_path(entry_id: entry.id), loading: :lazy do %>
          <div class="p-3 space-y-2" role="status">
            <p class="sr-only"><%= t(".loading") %></p>
            <% 4.times do %><div class="h-8 rounded-xl shimmer" aria-hidden="true"></div><% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
