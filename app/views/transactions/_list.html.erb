<%# locals: (transactions:, projected_recurring:, q:, pagy:) %>
<div id="transactions"
  data-controller="bulk-select checkbox-toggle drag-and-drop-import"
  data-bulk-select-singular-label-value="<%= t(".transaction") %>"
  data-bulk-select-plural-label-value="<%= t(".transactions") %>"
  data-bulk-select-selected-label-value="<%= t("transactions.selection_bar.selected") %>"
  data-bulk-select-edit-label-value="<%= t("transactions.selection_bar.edit") %>"
  class="flex flex-col gap-1 relative group scroll-mt-3">

  <%= form_with url: imports_path, method: :post, class: "hidden", data: { drag_and_drop_import_target: "form", turbo: false } do |f| %>
    <%= f.hidden_field "import[type]", value: "TransactionImport" %>
    <%= f.file_field "import[import_file]", class: "hidden", data: { drag_and_drop_import_target: "input" }, accept: ".csv" %>
  <% end %>

  <%= render "imports/drag_drop_overlay", title: t(".drag_drop_title"), subtitle: t(".drag_drop_subtitle") %>

  <%= render "transactions/searches/search" %>

  <div id="entry-selection-bar" data-bulk-select-target="selectionBar" class="flex justify-center hidden">
    <%= render "transactions/selection_bar" %>
  </div>

  <%# Select all, for a phone (the owner, 2026-10-19): it shows with the row
      checkboxes (checkbox-toggle) and ticks itself when every row on the page
      is picked; a computer has the column heading's box. %>
  <div class="lg:hidden">
    <div class="hidden" data-checkbox-toggle-target="selectionEntry">
      <label for="select_all_on_page" class="mb-1 flex h-11 cursor-pointer items-center gap-3 rounded-full bg-container px-4 text-sm font-semibold text-primary shadow-border-xs">
        <%= check_box_tag "select_all_on_page", "1", false,
              class: "checkbox checkbox--light",
              data: { action: "bulk-select#togglePageSelection", bulk_select_target: "pageCheckbox" } %>
        <span><%= t(".select_all", count: transactions.size) %></span>
      </label>
    </div>
  </div>

  <% if @pagy.count > 0 || (@projected_recurring.any? && @q.blank?) %>
    <div class="grow overflow-y-auto">
      <% if @transactions.any? %>
        <%# Column headings help a computer's wide rows; a phone's day lists
            need none (2026-10-17). %>
        <div class="grid-cols-12 rounded-xl px-5 py-2 text-xs uppercase font-medium text-secondary items-center mb-1 hidden md:grid">
          <div class="pl-0.5 col-span-5 flex items-center gap-4">
            <%= check_box_tag "selection_entry",
                class: "checkbox checkbox--light hidden lg:block",
                data: {
                  action: "bulk-select#togglePageSelection",
                  checkbox_toggle_target: "selectionEntry"
                } %>
            <p><%= t(".transaction") %></p>
          </div>

          <p class="col-span-3 md:block hidden"><%= t("transactions.form.category_label") %></p>
          <p class="col-span-2 md:block hidden"><%= t("transactions.form.tags_label") %></p>
          <p class="col-span-2 col-start-11 md:col-start-auto justify-self-end md:block"><%= t("transactions.show.amount") %></p>
        </div>
      <% end %>

      <div class="space-y-6">
        <%= entries_by_date(@transactions.map(&:entry), totals: true,
                            order: { "oldest" => :asc, "largest" => :sequence, "smallest" => :sequence }.fetch(@sort, :desc)) do |entries| %>
          <% if Current.user.show_split_grouped? %>
            <% group_split_entries(entries, @split_parents).each do |item| %>
              <% if item.is_a?(EntriesHelper::SplitGroup) %>
                <%= render "entries/split_group", split_group: item %>
              <% else %>
                <%= render item %>
              <% end %>
            <% end %>
          <% else %>
            <% entries.each do |entry| %>
              <%= render entry %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render "entries/empty" %>
  <% end %>

  <div class="pt-4">
    <%= render "shared/pagination", pagy: @pagy, anchor: "transactions" %>
  </div>
</div>
