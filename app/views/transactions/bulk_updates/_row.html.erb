<%# locals: (icon:) %>
<%# One row of the bulk edit sheet (the owner's design, 2026-10-19): the
    field's icon on a tile, the field itself, and "Will change" once it is
    filled in (bulk_edit_summary_controller marks the row). An inset hairline
    splits it from the row above. %>
<div class="sheet-row group/row relative flex items-start gap-3.5 px-4 py-3 not-first:before:absolute not-first:before:top-0 not-first:before:left-[4.125rem] not-first:before:right-0 not-first:before:border-t not-first:before:border-subdued"
     data-bulk-edit-summary-target="row">
  <span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-xl bg-surface-inset text-secondary group-data-[changed]/row:bg-link/15 group-data-[changed]/row:text-link" aria-hidden="true">
    <%= icon(icon, size: "md", color: "current") %>
  </span>
  <div class="min-w-0 grow"><%= yield %></div>
  <span class="mt-1 hidden shrink-0 rounded-full bg-link px-2.5 py-0.5 text-xs font-semibold text-inverse group-data-[changed]/row:inline-flex"><%= t("transactions.bulk_updates.new.will_change") %></span>
</div>
