<%# Activity's toolbar (the owner, 2026-10-18: a nice UI for search, filter
    and sort): a rounded search field, then round Filter and Sort buttons —
    Filter counts what is on, Sort names its order on a wider screen — and the
    selection toggle on a phone. The sort rides along as its own parameter, so
    searching and paging keep it. %>
<% active_filters = @q.except("amount_operator").sum { |_key, value| Array(value).compact_blank.size } %>
<% pill_classes = "press inline-flex h-11 shrink-0 items-center justify-center gap-2 rounded-full bg-container px-4 text-sm font-semibold text-primary shadow-border-xs hover:bg-container-hover transition-colors focus-ring" %>
<%= form_with url: transactions_path,
              id: "transactions-search",
              scope: :q,
              method: :get,
              data: { controller: "auto-submit-form" } do |form| %>
  <%= hidden_field_tag :per_page, params[:per_page] %>
  <%= hidden_field_tag :sort, @sort if @sort.present? && @sort != TransactionsController::SORTS.first %>

  <div class="flex items-center gap-2 mb-3">
    <label class="flex h-11 min-w-0 grow items-center gap-2 rounded-full bg-container px-4 shadow-border-xs focus-within:ring-2 focus-within:ring-link transition-shadow">
      <%= icon("search", color: "current", class: "shrink-0 text-secondary") %>
      <%= form.text_field :search,
                          placeholder: t(".search_placeholder"),
                          value: @q[:search],
                          class: "min-w-0 grow border-0 bg-transparent p-0 text-sm text-primary placeholder:text-secondary focus:outline-hidden focus:ring-0",
                          "data-auto-submit-form-target": "auto" %>
    </label>

    <%= render DS::Popover.new(variant: "button", no_padding: true) do |popover| %>
      <% popover.with_button(id: "transaction-filters-button", type: "button", class: pill_classes,
                             aria: { label: active_filters.positive? ? t(".active_filters", count: active_filters) : t(".filter") }) do %>
        <%= icon("list-filter", size: "sm", color: "current") %>
        <span class="hidden sm:inline"><%= t(".filter") %></span>
        <% if active_filters.positive? %>
          <span class="inline-flex min-w-5 h-5 items-center justify-center rounded-full bg-inverse px-1.5 text-xs font-bold text-inverse tabular"><%= active_filters %></span>
        <% end %>
      <% end %>

      <% popover.with_custom_content do %>
        <%= render "transactions/searches/menu", form: form %>
      <% end %>
    <% end %>

    <%= render DS::Menu.new(variant: :button, placement: "bottom-end") do |menu| %>
      <% menu.with_button(class: pill_classes, aria: { label: t("transactions.searches.sort.menu_label") }) do %>
        <%= icon("arrow-up-down", size: "sm", color: "current") %>
        <span class="hidden sm:inline"><%= t("transactions.searches.sort.options.#{@sort.presence || TransactionsController::SORTS.first}") %></span>
      <% end %>

      <% TransactionsController::SORTS.each do |sort| %>
        <% menu.with_item(
             variant: :link,
             text: t("transactions.searches.sort.options.#{sort}"),
             href: transactions_path(request.query_parameters.except("page", "sort").merge(sort == TransactionsController::SORTS.first ? {} : { "sort" => sort })),
             selected: sort == (@sort.presence || TransactionsController::SORTS.first)
           ) %>
      <% end %>
    <% end %>

    <%= button_tag type: "button",
        id: "toggle-checkboxes-button",
        aria: { label: t(".toggle_selection_checkboxes") },
        class: "lg:hidden #{pill_classes} w-11 px-0",
        data: {
          action: "click->checkbox-toggle#toggle",
          checkbox_toggle_target: "toggleButton"
        } do %>
      <%= icon("list-todo", size: "sm", color: "current") %>
    <% end %>
  </div>
<% end %>
