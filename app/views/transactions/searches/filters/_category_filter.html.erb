<%# locals: (form:) %>
<div data-controller="list-filter category-filter">
  <%= render DS::SearchInput.new(
        variant: :embedded,
        placeholder: t(".filter_category"),
        aria_label: t(".filter_category"),
        data: {
          list_filter_target: "input",
          action: "input->list-filter#filter"
        }
      ) %>
  <%# The owner's design (2026-10-19): one white card of rows, the checkbox on the right. %>
  <div class="my-2 overflow-hidden rounded-[1.25rem] bg-container shadow-border-xs" id="list" data-list-filter-target="list">
    <% family_categories.each do |category| %>
      <% is_child = category.parent_id.present? %>
      <div class="filterable-item relative flex flex-row-reverse items-center justify-between gap-3 min-h-14 px-4 py-2.5 has-[:checked]:bg-link/5 after:absolute after:inset-x-4 after:bottom-0 after:border-t after:border-subdued last:after:hidden" data-filter-name="<%= category.display_name %>">
        <%= form.check_box :categories,
                           {
                             multiple: true,
                             checked: @q[:categories]&.include?(category.filter_value),
                             class: "checkbox checkbox--light",
                             data: {
                               category_filter_target: "checkbox",
                               action: "change->category-filter#toggle",
                               category_id: category.id,
                               parent_id: category.parent_id
                             }
                           },
                           category.filter_value,
                           nil %>
        <%= form.label :categories, category.display_name, value: category.filter_value, class: "text-sm text-primary cursor-pointer flex items-center gap-1" do %>
          <% if is_child %>
            <%= icon("corner-down-right", size: "sm") %>
          <% end %>
          <%= render partial: "categories/badge", locals: { category: category } %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
