<%# locals: (form:) %>
<% accounts = Current.user.accessible_accounts.alphabetically.to_a %>
<div data-controller="list-filter">
  <%# The owner's design (2026-10-19): a white search field, then the accounts as one card of rows, the whole row a label so a tap anywhere checks it. %>
  <label class="flex h-12 items-center gap-2 rounded-2xl bg-container px-4 shadow-border-xs focus-within:ring-2 focus-within:ring-link transition-shadow">
    <%= icon("search", color: "current", class: "shrink-0 text-secondary") %>
    <input type="search"
           placeholder="<%= t("transactions.searches.menu.search_accounts") %>"
           aria-label="<%= t("transactions.searches.menu.search_accounts") %>"
           autocomplete="off"
           class="min-w-0 grow border-0 bg-transparent p-0 text-base text-primary placeholder:text-secondary focus:outline-hidden focus:ring-0"
           data-list-filter-target="input"
           data-action="input->list-filter#filter">
  </label>

  <div class="mt-4 mb-2 flex items-center justify-between px-1">
    <span class="text-[13px] font-semibold uppercase tracking-wide text-secondary"><%= t("transactions.searches.menu.accounts_count", count: accounts.size) %></span>
    <button type="button"
            class="press rounded-md text-sm font-semibold text-link focus-ring"
            data-action="transaction-filter-menu#selectAll">
      <%= t("transactions.searches.menu.select_all") %>
    </button>
  </div>

  <div id="list"
       class="overflow-hidden rounded-[1.25rem] bg-container shadow-border-xs"
       data-list-filter-target="list"
       data-transaction-filter-menu-target="accounts">
    <% accounts.each do |account| %>
      <label class="filterable-item relative flex min-h-17 cursor-pointer items-center gap-3 px-4 py-2.5 has-[:checked]:bg-link/5 after:absolute after:inset-x-4 after:bottom-0 after:border-t after:border-subdued last:after:hidden"
             data-filter-name="<%= account.name %>">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-surface-inset text-secondary">
          <%= icon(account.accountable_type == "CreditCard" ? "credit-card" : "landmark", color: "current") %>
        </span>
        <span class="min-w-0 grow">
          <span class="block truncate text-base font-semibold text-primary"><%= account.name %></span>
          <span class="block text-[13px] text-secondary"><%= account.short_subtype_label %></span>
        </span>
        <%= form.check_box :accounts,
                           {
                             multiple: true,
                             checked: @q[:accounts]&.include?(account.name),
                             class: "checkbox checkbox--light shrink-0"
                           },
                           account.name,
                           nil %>
      </label>
    <% end %>
  </div>
</div>
