<%# locals: (form:) %>
<div data-controller="list-filter">
  <%= render DS::SearchInput.new(
        variant: :embedded,
        placeholder: t(".filter_tags"),
        aria_label: t(".filter_tags"),
        data: {
          list_filter_target: "input",
          action: "input->list-filter#filter"
        }
      ) %>
  <%# The owner's design (2026-10-19): one white card of rows, the checkbox on the right. %>
  <div class="my-2 overflow-hidden rounded-[1.25rem] bg-container shadow-border-xs" id="list" data-list-filter-target="list">
    <% ([ Tag.untagged ] + Current.family.tags.alphabetically).each do |tag| %>
      <div class="filterable-item relative flex flex-row-reverse items-center justify-between gap-3 min-h-14 px-4 py-2.5 has-[:checked]:bg-link/5 after:absolute after:inset-x-4 after:bottom-0 after:border-t after:border-subdued last:after:hidden" data-filter-name="<%= tag.name %>">
        <%= form.check_box :tags,
                           {
                             multiple: true,
                             checked: @q[:tags]&.include?(tag.filter_value),
                             class: "checkbox checkbox--light"
                           },
                           tag.filter_value,
                           nil %>
        <%= form.label :tags, value: tag.filter_value, class: "text-sm text-primary flex items-center gap-2" do %>
          <% tag_color = tag.color.presence || Tag::UNCATEGORIZED_COLOR %>
          <span class="border text-sm font-medium px-3 py-1 rounded-full inline-flex items-center gap-2"
                style="
                  background-color: color-mix(in oklab, <%= tag_color %> 10%, transparent);
                  border-color: color-mix(in oklab, <%= tag_color %> 20%, transparent);
                  color: <%= tag_color %>;">
                <span class="size-1.5 rounded-full" style="background-color: <%= tag_color %>;"></span>
            <%= tag.name %>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
