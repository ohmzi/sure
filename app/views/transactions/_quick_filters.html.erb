<%# Quick filters (the owner's redesign, 2026-10-17): one tap to what most
    often needs a look — the uncategorized, this month, one account. The full
    filter form stays beside the search. %>
<% this_month = { start_date: Date.current.beginning_of_month.iso8601 } %>
<% current_q = (params[:q].respond_to?(:to_unsafe_h) ? params[:q].to_unsafe_h : {}).stringify_keys %>
<% chips = [] %>
<% chips << [ t("transactions.index.quick_filters.uncategorized", count: @uncategorized_count), transactions_categorize_path, false ] if @uncategorized_count.to_i.positive? %>
<%# Auto-matched transfers waiting for you to confirm them (2026-10-17). %>
<% needs_confirmation = Transfer.pending.joins(inflow_transaction: { entry: :account })
                                .merge(Account.where(id: Current.user.accessible_accounts.select(:id))).count %>
<% if needs_confirmation.positive? %>
  <% chips << [ t("transactions.index.quick_filters.needs_confirmation", count: needs_confirmation),
                transactions_path(q: { status: [ "needs_confirmation" ] }), current_q == { "status" => [ "needs_confirmation" ] } ] %>
<% end %>
<% chips << [ t("transactions.index.quick_filters.this_month"), transactions_path(q: this_month), current_q.slice("start_date") == this_month.stringify_keys && current_q.except("start_date").blank? ] %>
<%# Accounts with day-to-day activity (cash and cards), not a house or a car. %>
<% Current.user.accessible_accounts.visible.where(accountable_type: %w[Depository CreditCard]).alphabetically.limit(4).each do |account| %>
  <% chips << [ account.name, transactions_path(q: { account_ids: [ account.id ] }), current_q == { "account_ids" => [ account.id ] } ] %>
<% end %>
<nav aria-label="<%= t("transactions.index.quick_filters.label") %>">
  <ul class="flex flex-wrap gap-2">
    <% chips.each do |label, path, active| %>
      <li>
        <%= link_to label, path, aria: { current: ("page" if active) },
              class: class_names("inline-flex items-center h-9 px-3.5 rounded-full text-sm font-semibold whitespace-nowrap active:scale-95 transition focus-ring",
                                 active ? "bg-inverse text-inverse" : "border border-secondary bg-container text-primary hover:bg-container-hover") %>
      </li>
    <% end %>
  </ul>
</nav>
