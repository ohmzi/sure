<%# locals: (panel:) %>
<%# The per-document "what I understood" panel (spec §9, design D4). Read beside
    the document: what it decided (the settled class, the confidence, the account
    it resolved to), what it read (each field with its confidence, the doubts
    marked "check this"), the checks (pass / not checkable / fail), and what it
    became. An unread document is never an empty panel: it states the reason and
    the two ways forward. %>
<%# iOS grouped cards (2026-10-17): each part of the read is its own rounded
    card under a small uppercase heading. %>
<div class="flex h-full min-h-0 flex-col gap-5 overflow-auto" data-document-understanding>
  <h3 class="text-lg font-semibold tracking-tight text-primary"><%= t(".title") %></h3>

  <%# Why the document stopped and what fixes it (spec §6), above everything
      else it read. %>
  <% if (hold = panel.hold) %>
    <div class="space-y-2 rounded-2xl bg-destructive/5 p-4" data-document-hold>
      <p class="text-sm text-primary"><%= hold.message %></p>
      <%= render "documents/hold_actions", link: panel.link, hold: hold %>
    </div>
  <% end %>

  <% if panel.read? %>
    <%# What it decided: the class the router settled on, how sure it was, and
        the account the read resolved to (nil is said, not left blank). %>
    <div class="flex items-center gap-3 rounded-2xl bg-container-inset p-4">
      <%= render DS::FilledIcon.new(icon: panel.document_class.to_s == "statement" ? "landmark" : "receipt-text", hex_color: "var(--color-brand-500)", size: "lg") %>
      <div class="min-w-0 grow">
        <p class="font-semibold text-primary"><%= t("documents.source.#{panel.document_class}") %></p>
        <p class="truncate text-sm text-secondary"><%= panel.account&.name || t(".no_account") %></p>
      </div>
      <% if panel.classification_confidence.to_f.positive? %>
        <span class="shrink-0 rounded-full bg-container px-2.5 py-1 text-xs font-semibold text-secondary">
          <%= t(".confidence", percent: (panel.classification_confidence.to_f * 100).round) %>
        </span>
      <% end %>
    </div>

    <%# The class is shown in the header above ("what it decided"), so it is not
        repeated here; every other field is, with its own confidence. Filter by
        the field's verdict KEY, not its label: the label is translated, the key
        is not, so this stays correct in every locale. %>
    <% read_fields = panel.fields.reject { |field| field.key == "document_class" } %>
    <% if read_fields.any? %>
      <% currency = read_fields.find { |field| field.key == "currency" }&.value %>
      <section class="space-y-2">
        <p class="px-1 text-xs font-medium uppercase tracking-wide text-secondary"><%= t(".read") %></p>
        <dl class="rounded-2xl bg-container-inset divide-y divide-subdued">
          <% read_fields.each do |field| %>
            <%# A total reads as money and a date as a date; anything that does
                not parse is shown as it was read. %>
            <% value = field.value %>
            <% money_currency = currency.presence || Current.family&.currency %>
            <% if field.key == "total" && money_currency.present? && (amount = BigDecimal(value.to_s, exception: false)) && (Money::Currency.new(money_currency) rescue nil) %>
              <% value = Money.new(amount, money_currency).format %>
            <% elsif field.key == "date" && (parsed = (Date.iso8601(value.to_s) rescue nil)) %>
              <% value = l(parsed, format: :long) %>
            <% end %>
            <div class="flex items-start justify-between gap-3 px-4 py-2.5 text-sm" data-field="<%= field.key %>">
              <dt class="shrink-0 text-secondary"><%= field.label %></dt>
              <dd class="min-w-0 text-right">
                <span class="block break-words font-medium text-primary"><%= value %></span>
                <% if field.confidence.present? %>
                  <span class="block text-xs <%= field.unsure? ? "text-warning" : "text-secondary" %>">
                    <%= t(".confidence", percent: (field.confidence * 100).round) %><% if field.unsure? %>, <%= t(".check_this") %><% end %>
                  </span>
                <% end %>
              </dd>
            </div>
          <% end %>
        </dl>
      </section>
    <% end %>

    <% if panel.checks.any? %>
      <section class="space-y-2">
        <p class="px-1 text-xs font-medium uppercase tracking-wide text-secondary"><%= t(".checks") %></p>
        <div class="rounded-2xl bg-container-inset divide-y divide-subdued">
        <% panel.checks.each do |check| %>
          <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 px-4 py-2.5 text-sm">
            <% if check.state.nil? %>
              <%= icon("minus", size: "sm", color: "default") %>
            <% elsif check.state %>
              <%= icon("check", size: "sm", color: "success") %>
            <% else %>
              <%= icon("x", size: "sm", color: "destructive") %>
            <% end %>
            <span class="min-w-0 grow text-primary"><%= check.label.to_s.upcase_first %></span>
            <% if check.state.nil? %>
              <span class="ml-auto text-xs text-secondary"><%= t(".not_checkable") %></span>
            <% end %>
          </div>
        <% end %>
        </div>
      </section>
    <% end %>

    <%= render "documents/read_history", panel: panel %>

    <section class="space-y-2">
      <p class="px-1 text-xs font-medium uppercase tracking-wide text-secondary"><%= t(".became") %></p>
      <% if panel.outcomes.any? %>
        <div class="rounded-2xl bg-container-inset divide-y divide-subdued">
        <% panel.outcomes.each do |outcome| %>
          <div class="flex items-center justify-between gap-2 px-4 py-2.5 text-sm">
            <span class="text-secondary"><%= outcome.label %></span>
            <% detail = t(".state.#{outcome.detail}", default: outcome.detail) %>
            <%# Each outcome is linked to the thing it produced (spec §9). %>
            <% if outcome.url.present? %>
              <%= render DS::Link.new(text: detail, href: outcome.url) %>
            <% else %>
              <span class="text-primary"><%= detail %></span>
            <% end %>
          </div>
        <% end %>
        </div>
      <% else %>
        <p class="px-1 text-sm text-secondary"><%= t(".nothing_yet") %></p>
      <% end %>
    </section>
  <% else %>
    <%# Unread. A read still in flight says so and offers nothing to configure;
        a document that was never read owes the reader the reason and the two
        ways forward. Never an empty panel, never a false "not read". %>
    <div class="space-y-2">
      <p class="font-medium text-primary"><%= panel.reading? ? t(".reading") : t(".not_read_yet") %></p>
      <p class="text-sm text-secondary"><%= panel.empty_reason %></p>
    </div>
    <%= render "documents/read_history", panel: panel %>
    <% unless panel.reading? %>
      <div class="space-y-2">
        <div class="flex flex-wrap items-center gap-2">
          <%# Name the destination: a bare "Set up a provider" button never said
              where, which is why the owner could not find the key fields
              (report 2026-10-13). The link targets the AI provider section's
              `ai-provider` anchor. %>
          <%= render DS::Link.new(text: t(".unread.set_up_provider"), href: settings_ai_path(anchor: "ai-provider"), variant: "primary", size: "sm") %>
          <span class="text-sm text-secondary"><%= t(".unread.or") %></span>
          <%= render DS::Link.new(text: t(".unread.enter_by_hand"), href: new_transaction_path, variant: "outline", size: "sm") %>
        </div>
        <p class="text-xs text-secondary"><%= t(".unread.provider_location") %></p>
      </div>
    <% end %>
  <% end %>
</div>
