<%# locals: (entry:) %>
<%# Where this entry came from (spec N13): exactly one primary source, plus the
    documents that corroborate it as additive chips and an "edited by you"
    overlay. Read-only -- it renders, it writes nothing. Hosted by the
    transaction row (the trailing indicator cluster) and the detail drawer (the
    header and the section beside the documents panel). %>
<% provenance = entry.provenance %>
<div class="flex flex-wrap items-center gap-1" data-provenance="<%= dom_id(entry) %>">
  <%= render DS::Pill.new(
    label: provenance.label,
    tone: :neutral,
    marker: false,
    icon: entry_provenance_icon(provenance.primary)
  ) %>

  <%# The document that PRODUCED this entry, then the corroborating documents.
      A statement-born row's creating document hangs off its import, not
      `entry.document_links`, so without the producing document the row would
      name "from a document" yet offer no chip back to it. The producing document
      is the source, never corroboration (it is not part of `provenance.documents`,
      which `corroborated?` reads), and it is never double-listed: when it is also
      attached to the entry, `producing_document` is nil and the `documents` loop
      renders it once. A document the user deleted is still named -- the entry's
      provenance must not silently vanish -- but it has left the archive, so it
      renders as a dead source with no link. %>
  <% ([ provenance.producing_document ] + provenance.documents).compact.each do |document| %>
    <% if document.deleted_at.present? %>
      <%= render DS::Pill.new(
        label: t("entries.provenance.source_deleted", name: document.title.presence || document.original_filename),
        tone: :warning,
        marker: false,
        icon: "file-x",
        truncate: true
      ) %>
    <% else %>
      <%= link_to viewer_document_path(document), class: "inline-flex min-w-0 max-w-full" do %>
        <%= render DS::Pill.new(
          label: document.title.presence || document.original_filename,
          tone: :indigo,
          marker: false,
          icon: "file-text",
          truncate: true
        ) %>
      <% end %>
    <% end %>
  <% end %>

  <%# A displayed value no longer equals what the document said. An untouched
      AI read never carries this. %>
  <% if provenance.edited? %>
    <%= render DS::Pill.new(
      label: t("entries.provenance.edited"),
      tone: :warning,
      marker: false,
      icon: "pencil-line"
    ) %>
  <% end %>
</div>
