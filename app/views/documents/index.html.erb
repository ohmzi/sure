<%# The Documents page is the whole dropzone (design D2): document_dropzone_
    controller listens on `document`, so a file dropped anywhere posts it to the
    ONE intake endpoint, and the stream appends the new tile to #documents_grid
    without any navigation. %>
<div data-controller="document-dropzone"
     data-document-dropzone-url-value="<%= documents_intake_path %>"
     data-document-dropzone-failure-value="<%= t("documents.intake_bar.upload_failed") %>">
  <%= render DocumentBrowserComponent.new(
        family: :documents, title: t(".title"), url: documents_path,
        rows: @rows, pagy: @pagy, filters: @filters, tag_choices: @tag_choices
      ) do |browser| %>
    <% browser.with_upload do %>
      <%= render "documents/intake_bar" %>
    <% end %>
    <% browser.with_attention do %>
      <%= render DocumentsAttentionComponent.new(family: Current.family, user: Current.user) %>
    <% end %>
  <% end %>
</div>
