<%# The way in (Documents redesign, 2026-10-16): a floating + that opens the Add
    sheet — camera, photo library, any file, and the receipt's currency. Every
    picker's `change` takes the one upload path a dropped file takes
    (document_dropzone_controller#pick), and the page itself is still the drop
    target on a computer. %>

<%# The intake stream writes a refusal here. While empty it is visually hidden
    but stays in the accessibility tree, so the refusal is announced. %>
<p id="documents_intake_status" role="status" aria-live="polite"
   class="text-sm text-destructive empty:sr-only" data-document-dropzone-target="status"></p>

<button type="button"
        class="fixed z-20 right-4 bottom-[calc(5.75rem+env(safe-area-inset-bottom))] lg:bottom-8 inline-flex items-center justify-center size-14 rounded-full bg-inverse hover:bg-inverse-hover text-inverse shadow-lg active:scale-95 transition focus-ring"
        aria-controls="document_add_sheet" aria-haspopup="dialog"
        aria-label="<%= t(".add_document") %>" title="<%= t(".add_document") %>"
        data-controller="sheet-opener floating-action" data-sheet-opener-sheet-value="document_add_sheet"
        data-action="sheet-opener#open">
  <%= icon("plus", size: "xl", color: "current") %>
</button>

<%= render DS::Dialog.new(variant: "sheet", auto_open: false, disable_frame: true, width: "sm", id: "document_add_sheet") do |dialog| %>
  <% dialog.with_body do %>
    <%# Add sheet A (the owner's pick, 2026-10-17): a bold title, three big
        tiles — one tap per source — the receipt currency, and a Cancel pill. %>
    <h2 id="<%= dialog.title_id %>" class="text-2xl font-bold tracking-tight text-primary"><%= t(".title") %></h2>
    <p class="mt-1 text-sm text-secondary"><%= t(".subtitle") %></p>

    <div class="mt-5 grid grid-cols-3 gap-3">
      <%# Each tile is the label of its own hidden picker. %>
      <% [ [ "camera", t(".scan"), "var(--color-brand-500)", { accept: "image/*", capture: "environment" } ],
           [ "images", t(".photos"), "var(--color-cyan-600)", { accept: "image/*", multiple: true } ],
           [ "folder-open", t(".choose_file"), "var(--color-green-600)", { accept: "image/*,application/pdf,.csv,.ofx,.qfx,.xlsx", multiple: true } ] ].each do |icon_key, label, tint, input| %>
        <label class="flex flex-col items-center gap-2.5 rounded-2xl bg-container-inset px-2 py-4 cursor-pointer hover:bg-container-inset-hover active:scale-95 transition has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-link">
          <%= render DS::FilledIcon.new(icon: icon_key, hex_color: tint, size: "lg", rounded: true) %>
          <span class="text-sm font-semibold text-primary"><%= label %></span>
          <%= tag.input type: "file", name: "document", class: "sr-only",
                data: { action: "change->document-dropzone#pick" }, **input %>
        </label>
      <% end %>
    </div>

    <%# The currency a receipt or bill is in (the owner's rule): preset to the
        family's display currency; a statement ignores it — its account
        decides. %>
    <div class="mt-4" data-intake-currency>
      <%= fields do |form| %>
        <%= render DS::Select.new(form: form, method: :currency,
                                  items: Money::Currency.as_options.map { |currency| { label: "#{currency.iso_code} — #{currency.name}", value: currency.iso_code } },
                                  selected: Current.family.currency, searchable: true,
                                  label: t(".currency_label"),
                                  html_options: { data: { "document-dropzone-target": "currency" } }) %>
      <% end %>
    </div>

    <div class="mt-5">
      <%= render DS::Button.new(text: t(".cancel"), variant: :secondary, size: :lg, full_width: true,
                                type: "button", data: { action: "DS--dialog#close" }) %>
    </div>
    <p class="mt-3 text-center text-xs text-secondary"><%= t(".footnote") %></p>
  <% end %>
<% end %>
