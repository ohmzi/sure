<%# The slim bar (design D2: "slim bar, drop anywhere"). One row: the picker, the
    drop hint, a search affordance, and the status line the intake stream writes
    a refusal into. The page itself is the drop target — document_dropzone_
    controller listens on `document` — so this bar is only the visible half. %>
<div class="flex flex-wrap items-center gap-3">
  <%# The button is the label; the chosen file's `change` is what uploads it
      (document_dropzone_controller#pick), the same path a dropped one takes. %>
  <label class="flex items-center gap-2 cursor-pointer rounded-lg border border-secondary px-3 py-2 text-sm text-primary hover:bg-surface-hover focus-within:bg-surface-hover">
    <%= icon("plus", size: "sm") %>
    <span><%= t(".add_document") %></span>
    <input type="file" name="document" accept="image/*,application/pdf,.csv,.ofx,.qfx,.xlsx"
           class="hidden" data-action="change->document-dropzone#pick">
  </label>

  <span class="text-sm text-secondary"><%= t(".drop_hint") %></span>

  <%# The intake stream updates this span with a refusal; empty until then. %>
  <span id="documents_intake_status" role="status" aria-live="polite"
        class="text-sm text-destructive" data-document-dropzone-target="status"></span>

  <%# The filter form below carries the search field; this is the affordance
      that takes you to it. %>
  <%= link_to "#q_search", class: "ml-auto flex items-center gap-1.5 text-sm text-secondary hover:text-primary" do %>
    <%= icon("search", size: "sm") %>
    <span><%= t(".search") %></span>
  <% end %>
</div>
