<%# The way in (Documents redesign, 2026-10-16): a floating + that opens the Add
    sheet — camera, photo library, any file, and the receipt's currency. Every
    picker's `change` takes the one upload path a dropped file takes
    (document_dropzone_controller#pick), and the page itself is still the drop
    target on a computer. %>

<%# The intake stream writes a refusal here. While empty it is visually hidden
    but stays in the accessibility tree, so the refusal is announced. %>
<p id="documents_intake_status" role="status" aria-live="polite"
   class="text-sm text-destructive empty:sr-only" data-document-dropzone-target="status"></p>

<%= render DS::Fab.new(icon: "plus", label: t(".add_document"),
      aria: { controls: "document_add_sheet", haspopup: "dialog" },
      data: { controller: "sheet-opener", sheet_opener_sheet_value: "document_add_sheet", action: "sheet-opener#open" }) %>

<%= render "documents/add_sheet" %>
