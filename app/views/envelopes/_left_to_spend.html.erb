<%# locals: (budget:) %>
<%# The month at a glance (the owner's redesign, 2026-10-17): what is left to
    spend, large, and how much of the budget is gone. Hidden until the month
    has a budget total. The Alive pass (2026-10-18): a coloured hero, green
    while there is money left, with today marked on the bar so "am I ahead?"
    reads at a glance. %>
<% budgeted = budget.budgeted_spending.to_d %>
<% if budgeted.positive? %>
  <% spent = budget.actual_spending.to_d %>
  <% left = budgeted - spent %>
  <% month_days = (budget.end_date - budget.start_date).to_i + 1 %>
  <% today_day = (Date.current - budget.start_date).to_i + 1 %>
  <% in_month = today_day.between?(1, month_days) %>
  <section aria-label="<%= t("envelopes.left_to_spend.title") %>"
           class="relative overflow-hidden rounded-[30px] p-5 space-y-3 text-inverse rise <%= left.negative? ? "bg-destructive shadow-[0_18px_40px_-18px_var(--color-destructive)]" : "bg-success shadow-[0_18px_40px_-18px_var(--color-success)]" %>">
    <span aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-28 size-56 rounded-full bg-white/10"></span>
    <p class="relative text-sm font-semibold opacity-85"><%= t("envelopes.left_to_spend.title") %></p>
    <p class="relative text-[44px] leading-none font-extrabold tracking-tight privacy-sensitive">
      <%= format_money(Money.new(left, budget.currency)) %>
    </p>
    <div class="relative h-3 rounded-full bg-white/25" role="presentation">
      <span class="grow-right absolute inset-y-0 left-0 rounded-full bg-on-accent" style="width: <%= (spent / budgeted * 100).clamp(0, 100).round %>%"></span>
      <% if in_month %>
        <span class="absolute -inset-y-1.5 w-1 -translate-x-1/2 rounded-full bg-black/45" style="left: <%= (today_day.to_f / month_days * 100).round(1) %>%"></span>
      <% end %>
    </div>
    <div class="relative flex flex-wrap justify-between gap-x-3 text-[13px] font-semibold opacity-90 privacy-sensitive">
      <span><%= t("envelopes.left_to_spend.spent_of", spent: format_money(Money.new(spent, budget.currency)), budgeted: format_money(Money.new(budgeted, budget.currency))) %></span>
      <% if in_month %>
        <span><%= t("envelopes.left_to_spend.today", day: today_day, days: month_days) %></span>
      <% end %>
    </div>
  </section>
<% end %>
