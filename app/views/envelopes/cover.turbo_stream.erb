<%= flash_notification_stream_items %>

<%# Ruling M4-L4 (2026-10-10 close-out): the gesture moves money on the whole
    surface, so the stream refreshes the figures the touched rows cannot show —
    the ready-to-assign banner and the credit-card payments group. %>
<%= turbo_stream.replace dom_id(@budget, :ready_to_assign) do %>
  <%= render "envelopes/ready_to_assign", budget: @budget %>
<% end %>

<%= turbo_stream.replace dom_id(@budget, :credit_card_payments) do %>
  <%= render "envelopes/credit_card_group", budget: @budget %>
<% end %>

<% [ @from, @to ].each do |budget_category| %>
  <%= turbo_stream.replace dom_id(budget_category, :envelope) do %>
    <%= render "envelopes/envelope_row", budget_category: budget_category.reload, budget: @budget %>
  <% end %>
<% end %>
