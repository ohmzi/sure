<%# locals: (budget_category:, budget:) %>
<%# On a phone the name has its own line and the three figures share the next,
    each labelled, so long amounts ("CA$1,234.00") never run together (the
    owner, 2026-10-17); from lg up it is the one-line row, the labels living in
    the figures' alignment. %>
<div id="<%= dom_id(budget_category, :envelope) %>" class="px-3 py-2 space-y-2 lg:space-y-0 lg:grid lg:grid-cols-12 lg:items-center lg:gap-2">
  <div class="lg:col-span-6 flex items-center gap-2 min-w-0">
    <%# A ring that fills in the category's colour, its icon inside (the Alive
        pass, 2026-10-18); red once the envelope is overspent. %>
    <% ring_budgeted = budget_category.budgeted_spending.to_d %>
    <% ring_pct = ring_budgeted.positive? ? (budget_category.actual_spending.to_d / ring_budgeted).clamp(0, 1).to_f : 0 %>
    <% ring_color = budget_category.available_to_spend.negative? ? "var(--color-destructive)" : budget_category.category.color %>
    <span class="relative flex size-10 shrink-0 items-center justify-center" style="color: <%= budget_category.category.color %>">
      <svg viewBox="0 0 40 40" class="absolute inset-0 size-10 -rotate-90" aria-hidden="true">
        <circle cx="20" cy="20" r="16" fill="currentColor" fill-opacity="0.12" stroke="currentColor" stroke-opacity="0.18" stroke-width="4"></circle>
        <circle cx="20" cy="20" r="16" fill="none" stroke="<%= ring_color %>" stroke-width="4" stroke-linecap="round"
                stroke-dasharray="<%= (ring_pct * 100.53).round(2) %> 100.53"></circle>
      </svg>
      <%= icon(budget_category.category.lucide_icon.presence || "shapes", size: "sm", color: "current", class: "relative") %>
    </span>
    <span class="truncate font-semibold text-primary"><%= budget_category.category.display_name %></span>
    <%# Opens the shared move dialog filled from this row. The params match
        budget_move_controller's `open({ params })`, which drives the
        `toSelect` destination select — there is no `toId` target. %>
    <button type="button"
            class="text-subdued hover:text-primary p-1 rounded-md focus-ring"
            title="<%= t("envelopes.move.button_title") %>"
            aria-label="<%= t("envelopes.move.button_title") %>"
            data-action="budget-move#open"
            data-budget-move-from-id-param="<%= budget_category.id %>"
            data-budget-move-from-name-param="<%= budget_category.category.display_name %>"
            data-budget-move-category-id-param="<%= budget_category.category_id %>"
            data-budget-move-parent-id-param="<%= budget_category.category.parent_id %>"
            data-budget-move-available-param="<%= budget_category.budgeted_spending_money.format %>">
      <%= icon("arrow-left-right", size: "sm") %>
    </button>
  </div>
  <div class="grid grid-cols-3 gap-2 items-end lg:contents">
    <div class="min-w-0 lg:col-span-2">
      <p class="lg:hidden text-xs text-secondary mb-0.5"><%= t("envelopes.row.assigned") %></p>
      <%= render "envelopes/assign_form", budget_category: budget_category, budget: budget %>
    </div>
    <div class="min-w-0 lg:col-span-2 text-right">
      <p class="lg:hidden text-xs text-secondary mb-0.5"><%= t("envelopes.row.spent") %></p>
      <span class="block truncate tabular-nums privacy-sensitive"><%= format_money(budget_category.actual_spending_money) %></span>
    </div>
    <div class="min-w-0 lg:col-span-2 text-right">
      <p class="lg:hidden text-xs text-secondary mb-0.5"><%= t("envelopes.row.available") %></p>
      <span class="block truncate tabular-nums privacy-sensitive <%= budget_category.available_to_spend.negative? ? "text-destructive" : "text-primary" %>">
        <%= format_money(budget_category.available_to_spend_money) %>
      </span>
    </div>
  </div>
  <%# How full the envelope is (the owner's redesign, 2026-10-17): the
      category's colour, or the warning colour once it is overspent. %>
  <% budgeted = budget_category.budgeted_spending.to_d %>
  <% if budgeted.positive? %>
    <% spent_pct = (budget_category.actual_spending.to_d / budgeted * 100).clamp(0, 100).round %>
    <div class="lg:col-span-12 h-1.5 rounded-full bg-container-inset overflow-hidden" role="presentation">
      <% if budget_category.available_to_spend.negative? %>
        <span class="block h-full w-full rounded-full bg-warning"></span>
      <% else %>
        <span class="block h-full rounded-full" style="width: <%= spent_pct %>%; background-color: <%= budget_category.category.color %>"></span>
      <% end %>
    </div>
  <% end %>
</div>
