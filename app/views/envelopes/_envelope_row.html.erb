<%# locals: (budget_category:, budget:) %>
<div id="<%= dom_id(budget_category, :envelope) %>" class="grid grid-cols-12 items-center gap-2 px-3 py-2">
  <div class="col-span-6 flex items-center gap-2 min-w-0">
    <span class="w-1 h-3 rounded-xl" style="background-color: <%= budget_category.category.color %>"></span>
    <span class="truncate text-primary"><%= budget_category.category.display_name %></span>
    <%# Opens the shared move dialog filled from this row. The params match
        budget_move_controller's `open({ params })`, which drives the
        `toSelect` destination select — there is no `toId` target. %>
    <button type="button"
            class="text-subdued hover:text-primary p-1 rounded-md focus-ring"
            title="<%= t("envelopes.move.button_title") %>"
            aria-label="<%= t("envelopes.move.button_title") %>"
            data-action="budget-move#open"
            data-budget-move-from-id-param="<%= budget_category.id %>"
            data-budget-move-from-name-param="<%= budget_category.category.display_name %>"
            data-budget-move-category-id-param="<%= budget_category.category_id %>"
            data-budget-move-parent-id-param="<%= budget_category.category.parent_id %>"
            data-budget-move-available-param="<%= budget_category.budgeted_spending_money.format %>">
      <%= icon("arrow-left-right", size: "sm") %>
    </button>
  </div>
  <div class="col-span-2">
    <%= render "envelopes/assign_form", budget_category: budget_category, budget: budget %>
  </div>
  <span class="col-span-2 text-right tabular-nums privacy-sensitive"><%= format_money(budget_category.actual_spending_money) %></span>
  <span class="col-span-2 text-right tabular-nums privacy-sensitive <%= budget_category.available_to_spend.negative? ? "text-destructive" : "text-primary" %>">
    <%= format_money(budget_category.available_to_spend_money) %>
  </span>
  <%# How full the envelope is (the owner's redesign, 2026-10-17): the
      category's colour, or the warning colour once it is overspent. %>
  <% budgeted = budget_category.budgeted_spending.to_d %>
  <% if budgeted.positive? %>
    <% spent_pct = (budget_category.actual_spending.to_d / budgeted * 100).clamp(0, 100).round %>
    <div class="col-span-12 h-1.5 rounded-full bg-container-inset overflow-hidden" role="presentation">
      <% if budget_category.available_to_spend.negative? %>
        <span class="block h-full w-full rounded-full bg-warning"></span>
      <% else %>
        <span class="block h-full rounded-full" style="width: <%= spent_pct %>%; background-color: <%= budget_category.category.color %>"></span>
      <% end %>
    </div>
  <% end %>
</div>
