<%# locals: (budget:) %>
<% rta = Budget::ReadyToAssign.new(family: budget.family, budget: budget).amount %>
<div id="<%= dom_id(budget, :ready_to_assign) %>" data-envelope-target="banner"
     class="bg-container rounded-xl shadow-border-xs p-4 flex items-center justify-between">
  <div>
    <h2 class="text-lg font-medium text-primary"><%= t("envelopes.ready_to_assign.heading") %></h2>
    <p class="text-xs text-secondary"><%= t("envelopes.ready_to_assign.hint") %></p>
    <%# Sure's typed forecast, shown beside RTA and never driving it (spec 9.1). %>
    <p class="text-xs text-secondary privacy-sensitive" data-envelope-target="expected-income">
      <%= t("envelopes.ready_to_assign.expected_income",
            amount: format_money(budget.expected_income_money)) %>
    </p>
  </div>
  <span class="text-2xl font-medium privacy-sensitive <%= rta.negative? ? "text-destructive" : "text-primary" %>">
    <%= format_money(Money.new(rta, budget.currency)) %>
  </span>
</div>
