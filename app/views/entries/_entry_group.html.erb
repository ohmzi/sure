<%# locals: (date:, entries:, content:, totals: false) %>

<%# A day of activity as an iOS list (2026-10-17): the date and the day's
    total above one rounded card of rows. %>
<div id="entry-group-<%= date %>" class="w-full mb-3" data-bulk-select-target="group">
  <div class="pt-2 pb-1.5 px-3 flex items-center justify-between font-semibold text-xs text-secondary">
    <div class="flex pl-0.5 items-center gap-4">
        <%= check_box_tag "#{date}_entries_selection",
                          class: ["checkbox checkbox--light hidden lg:block", "lg:hidden": entries.size == 0],
                          id: "selection_entry_#{date}",
                          data: {
                            action: "bulk-select#toggleGroupSelection",
                            checkbox_toggle_target: "selectionEntry"
                          } %>

      <p class="uppercase space-x-1.5">
        <%= tag.span I18n.l(date, format: :long) %>
        <span>·</span>
        <%= tag.span entries.size %>
      </p>
    </div>

    <% if totals %>
      <div id="entry-group-<%= date %>-totals" class="privacy-sensitive">
        <%= totals_by_currency(collection: entries, money_method: :amount_money, negate: true) %>
      </div>
    <% end %>
  </div>
  <div class="bg-container shadow-border-xs rounded-2xl overflow-hidden">
    <%= content %>
  </div>
</div>
