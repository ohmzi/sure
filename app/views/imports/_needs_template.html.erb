<%# locals: (import:) %>
<% statement = import.account_statement %>
<% failed = statement.extraction_failed? %>

<div class="h-full flex flex-col justify-center items-center">
  <div class="space-y-6 max-w-lg w-full">
    <div class="mx-auto bg-warning/10 h-8 w-8 rounded-full flex items-center justify-center">
      <%= icon "triangle-alert", class: "text-warning" %>
    </div>

    <div class="text-center space-y-2">
      <h1 class="font-medium text-primary text-center text-3xl"><%= t(failed ? ".failed_title" : ".title") %></h1>
      <p class="text-sm text-secondary"><%= t(failed ? ".failed_description" : ".description") %></p>
    </div>

    <div id="<%= dom_id(statement) %>" class="bg-container border border-primary rounded-xl p-4 space-y-3">
      <div class="space-y-2">
        <h2 class="font-medium text-primary"><%= t(".archived_statement") %></h2>
        <p class="text-sm text-secondary px-3 py-2 bg-container-inset rounded-lg">
          <%= link_to statement.filename, account_statement_path(statement), class: "text-primary hover:text-primary-hover" %>
        </p>
      </div>
      <p class="text-sm text-secondary"><%= t(failed ? ".failed_fix_path" : ".fix_path") %></p>
    </div>

    <% if failed %>
      <%= button_to t(".retry"), retry_statement_ocr_import_path(import), method: :post,
            class: "w-full rounded-lg bg-container-inset px-4 py-2 text-sm font-medium text-primary" %>
    <% end %>

    <%= render DS::Button.new(
      text: t(".back_to_imports"),
      href: imports_path,
      variant: :secondary,
      full_width: true
    ) %>
  </div>
</div>
