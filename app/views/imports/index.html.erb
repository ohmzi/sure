<%= content_for :page_title, t(".title") %>

<%= settings_section do %>
  <div class="rounded-xl bg-container-inset space-y-1 p-1">

    <% if @imports.any? %>
      <%# Desktop: the table. Phone: the same row as a card, so nothing is
          hidden behind a horizontal swipe. %>
      <div class="hidden overflow-x-auto md:block">
        <table class="w-full">
          <thead>
            <tr class="text-xs uppercase font-medium text-secondary border-b border-divider">
              <th class="px-2 py-3 text-left min-w-44">
                <%= t("imports.table.header.date") %>
              </th>
              <th class="px-2 py-3 text-left min-w-32">
                <%= t("imports.table.header.operation") %>
              </th>
              <th class="px-2 py-3 text-left min-w-24">
                <%= t("imports.table.header.status") %>
              </th>
              <th class="px-2 py-3 text-right min-w-20">
                <%= t("imports.table.header.actions") %>
              </th>
            </tr>
          </thead>
          <tbody>
          <% @imports.ordered.each do |import| %>
            <tr id="<%= dom_id import %>" class="border-b border-subdued hover:bg-surface-hover">
              <td class="px-2 py-3">
                <span class="text-sm text-secondary">
                  <%= l(import.updated_at, format: :long) %>
                </span>
              </td>
              <td class="px-2 py-3">
                <%= link_to import_path(import), class: "font-medium text-sm text-primary hover:underline" do %>
                  <% if import.account.present? %>
                    <%= import.account.name + " " %>
                  <% end %>
                  <%= import.type.titleize.gsub(/ Import\z/, "") %>
                <% end %>
              </td>
              <td class="px-2 py-3">
                <%= render "imports/status_badge", import: import %>
              </td>
              <td class="px-2 py-3 text-right">
                <%= render "imports/row_actions", import: import %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>

      <%# On a phone each import is an iOS list row (2026-10-19): a tile for its
          kind, its name (the row opens it) and when it last changed, its
          status, and one menu for the rest, rather than a row of bare
          trash, undo and eye icons. %>
      <div class="md:hidden">
        <% @imports.ordered.each do |import| %>
          <div id="mobile_<%= dom_id(import) %>" class="relative flex items-center gap-2 min-h-[3.75rem] pl-3 pr-1 not-first:before:absolute not-first:before:top-0 not-first:before:left-14 not-first:before:right-0 not-first:before:border-t not-first:before:border-subdued">
            <%= link_to import_path(import), class: "flex min-w-0 flex-1 items-center gap-3 py-2 rounded-lg focus-ring" do %>
              <span class="flex size-8 shrink-0 items-center justify-center rounded-[9px] bg-surface-inset theme-dark:bg-container-inset text-primary" aria-hidden="true">
                <%= icon(import_type_icon(import), size: "sm", color: "current") %>
              </span>
              <span class="min-w-0">
                <span class="block truncate text-[15px] font-semibold text-primary">
                  <% if import.account.present? %>
                    <%= import.account.name + " " %>
                  <% end %>
                  <%= import.type.titleize.gsub(/ Import\z/, "") %>
                </span>
                <span class="block truncate text-xs text-secondary"><%= l(import.updated_at, format: :short) %></span>
              </span>
            <% end %>
            <div class="shrink-0">
              <%= render "imports/status_badge", import: import %>
            </div>
            <%= render "imports/row_menu", import: import %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-secondary text-center py-8 font-medium">
        <%= t("imports.table.empty") %>
      </p>
    <% end %>
  </div>

  <% if @pagy.pages > 1 %>
    <div class="mt-4">
      <%= render "shared/pagination", pagy: @pagy %>
    </div>
  <% end %>

  <%= render DS::Fab.new(icon: "plus", label: t("imports.index.new"), href: new_import_path, frame: :modal, class: "md:hidden") %>
  <%= link_to new_import_path,
              class: "max-md:hidden bg-container-inset inline-flex items-center justify-center gap-2 hover:bg-container-inset-hover rounded-lg px-4 py-2 w-full font-medium text-primary text-sm text-center",
              data: { turbo_frame: :modal } do %>
    <%= icon("plus") %>
    <%= t("imports.index.new") %>
  <% end %>
<% end %>
