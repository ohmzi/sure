<div class="space-y-4">
  <% unless health.healthy? %>
    <%= render DS::Alert.new(
      title: t("admin.system_health.show.alert.title"),
      message: t("shared.sidekiq_health_banner.reasons.#{health.reason}"),
      variant: :warning,
      live: :polite
    ) %>
  <% end %>

  <%= render DS::Card.new(class: "gap-4") do %>
    <div>
      <h2 class="text-lg font-semibold text-primary"><%= t("admin.system_health.show.status_section_title") %></h2>
      <p class="mt-1 text-sm text-secondary"><%= t("admin.system_health.show.status_section_description") %></p>
    </div>

    <dl class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.show.labels.status") %></dt>
        <dd>
          <%= render DS::Pill.new(
            label: t("admin.system_health.show.values.#{health.healthy? ? :healthy : :unhealthy}"),
            tone: health.healthy? ? :success : :warning,
            marker: false
          ) %>
        </dd>
      </div>
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.show.labels.processes") %></dt>
        <dd class="text-primary font-medium"><%= health.processes_count %></dd>
      </div>
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.show.labels.last_heartbeat") %></dt>
        <dd class="text-primary font-medium">
          <% if health.last_heartbeat_at %>
            <%= t("admin.system_health.show.values.time_ago", time_ago: time_ago_in_words(health.last_heartbeat_at)) %>
          <% else %>
            <%= t("admin.system_health.show.values.never") %>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.show.labels.max_queue_latency") %></dt>
        <dd class="text-primary font-medium">
          <%= t("admin.system_health.show.values.seconds", seconds: number_with_precision(health.max_queue_latency, precision: 1)) %>
        </dd>
      </div>
    </dl>
  <% end %>

  <%= render DS::Card.new(class: "gap-4") do %>
    <div>
      <h2 class="text-lg font-semibold text-primary"><%= t("admin.system_health.documents.title") %></h2>
      <p class="mt-1 text-sm text-secondary"><%= t("admin.system_health.documents.description") %></p>
    </div>

    <dl class="grid grid-cols-2 md:grid-cols-3 gap-4 text-sm">
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.documents.documents") %></dt>
        <dd class="text-primary font-medium"><%= document_health.documents %></dd>
      </div>
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.documents.in_flight") %></dt>
        <dd class="text-primary font-medium"><%= document_health.in_flight %></dd>
      </div>
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.documents.proven") %></dt>
        <dd class="text-primary font-medium"><%= document_health.proven %></dd>
      </div>
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.documents.unverified") %></dt>
        <dd class="<%= document_health.unverified.positive? ? "text-warning" : "text-primary" %> font-medium"><%= document_health.unverified %></dd>
      </div>
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.documents.held") %></dt>
        <dd class="<%= document_health.held.positive? ? "text-warning" : "text-primary" %> font-medium"><%= document_health.held %></dd>
      </div>
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.documents.retrying") %></dt>
        <dd class="text-primary font-medium"><%= document_health.retrying %></dd>
      </div>
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.documents.exhausted") %></dt>
        <dd class="<%= document_health.exhausted.positive? ? "text-destructive" : "text-primary" %> font-medium"><%= document_health.exhausted %></dd>
      </div>
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.documents.awaiting_review") %></dt>
        <dd class="text-primary font-medium"><%= document_health.awaiting_review %></dd>
      </div>
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.documents.pending_imports") %></dt>
        <dd class="<%= document_health.pending_imports.positive? ? "text-warning" : "text-primary" %> font-medium"><%= document_health.pending_imports %></dd>
      </div>
    </dl>

    <% unless document_health.healthy? %>
      <p class="text-sm text-warning"><%= t("admin.system_health.documents.attention") %></p>
    <% end %>
  <% end %>

  <%= render DS::Card.new(class: "gap-4") do %>
    <div>
      <h2 class="text-lg font-semibold text-primary"><%= t("admin.system_health.operations.title") %></h2>
      <p class="mt-1 text-sm text-secondary"><%= t("admin.system_health.operations.description", days: operator_metrics.window_days) %></p>
    </div>

    <dl class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.operations.llm_calls") %></dt>
        <dd class="text-primary font-medium"><%= number_with_delimiter(operator_metrics.llm_calls) %></dd>
      </div>
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.operations.provider_error_rate") %></dt>
        <% error_rate = operator_metrics.provider_error_rate %>
        <dd class="<%= error_rate&.positive? ? "text-warning" : "text-primary" %> font-medium">
          <% if error_rate %>
            <%= number_to_percentage(error_rate * 100, precision: 1) %>
          <% else %>
            <%= t("admin.system_health.operations.values.no_calls") %>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.operations.llm_tokens") %></dt>
        <dd class="text-primary font-medium"><%= number_with_delimiter(operator_metrics.llm_tokens) %></dd>
      </div>
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.operations.llm_estimated_cost") %></dt>
        <dd class="text-primary font-medium"><%= number_to_currency(operator_metrics.llm_estimated_cost, precision: 2) %></dd>
      </div>
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.operations.provider_latency") %></dt>
        <dd class="text-secondary"><%= t("admin.system_health.operations.values.provider_latency_unavailable") %></dd>
      </div>
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.operations.import_publish_latency") %></dt>
        <dd class="text-primary font-medium">
          <% if (latency = operator_metrics.import_latency) %>
            <%= t("admin.system_health.operations.values.import_latency",
                  average: number_with_precision(latency[:average_seconds], precision: 1),
                  p95: number_with_precision(latency[:p95_seconds], precision: 1),
                  samples: latency[:samples]) %>
            <span class="block text-xs font-normal text-secondary"><%= t("admin.system_health.operations.values.import_latency_help") %></span>
          <% else %>
            <%= t("admin.system_health.operations.values.no_imports") %>
          <% end %>
        </dd>
      </div>
    </dl>

    <div class="flex justify-end">
      <%= render DS::Link.new(
        href: settings_llm_usage_path,
        variant: :outline,
        size: :sm,
        icon: "activity",
        text: t("admin.system_health.operations.llm_usage_details")
      ) %>
    </div>
  <% end %>

  <%= render DS::Card.new(class: "gap-4") do %>
    <div>
      <h2 class="text-lg font-semibold text-primary"><%= t("admin.system_health.show.counters_section_title") %></h2>
      <p class="mt-1 text-sm text-secondary"><%= t("admin.system_health.show.counters_section_description") %></p>
    </div>

    <dl class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.show.labels.enqueued") %></dt>
        <dd class="text-primary font-medium"><%= number_with_delimiter(health.enqueued_count) %></dd>
      </div>
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.show.labels.retries") %></dt>
        <dd class="text-primary font-medium"><%= number_with_delimiter(health.retry_count) %></dd>
      </div>
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.show.labels.failed") %></dt>
        <dd class="text-primary font-medium"><%= number_with_delimiter(health.failed_count) %></dd>
      </div>
      <div>
        <dt class="text-secondary"><%= t("admin.system_health.show.labels.processed_total") %></dt>
        <dd class="text-primary font-medium"><%= number_with_delimiter(health.processed_count) %></dd>
      </div>
    </dl>
  <% end %>

  <%= render DS::Card.new(class: "gap-4") do %>
    <div>
      <h2 class="text-lg font-semibold text-primary"><%= t("admin.system_health.show.queues_section_title") %></h2>
      <p class="mt-1 text-sm text-secondary"><%= t("admin.system_health.show.queues_section_description") %></p>
    </div>

    <% breakdown = health.queue_breakdown %>
    <% if breakdown.empty? %>
      <p class="text-sm text-secondary"><%= t("admin.system_health.show.values.no_queues") %></p>
    <% else %>
      <%= render DS::Table.new(rows: breakdown, inset: true, label: t("admin.system_health.show.queues_section_title")) do |table| %>
        <% table.with_column(t("admin.system_health.show.labels.queue")) { |(name)| name } %>
        <% table.with_column(t("admin.system_health.show.labels.size"), numeric: true) { |(_name, size)| number_with_delimiter(size) } %>
        <% table.with_column(t("admin.system_health.show.labels.latency"), numeric: true) do |(_name, _size, latency)| %>
          <%= t("admin.system_health.show.values.seconds", seconds: number_with_precision(latency, precision: 1)) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <% if push_notification_test %>
    <%= render "push_notifications", disabled_reason: push_disabled_reason,
      latest_test: latest_push_test, results: push_test_results %>
  <% end %>
</div>
