<%# locals: (category:, subcategories: [], has_transactions: false) %>

<%# An iOS list row (the owner, 2026-10-19: "more beautiful versions"): the
    category's icon in its colour on a tile tinted with it, its name, and the
    actions menu. Tapping the row opens it for editing; a subcategory sits
    indented under its parent on a smaller tile. Rows after the first get an inset hairline
    that starts where the name does. %>
<% sub = category.parent_id.present? %>
<div id="<%= dom_id(category) %>"
     class="<%= class_names("relative flex items-center gap-2 min-h-[3.25rem] pr-2 bg-container",
                            sub ? "pl-12" : "pl-4",
                            "not-first:before:absolute not-first:before:top-0 not-first:before:right-0 not-first:before:border-t not-first:before:border-subdued",
                            sub ? "not-first:before:left-[5.25rem]" : "not-first:before:left-[3.75rem]") %>">
  <%= link_to edit_category_path(category),
        class: "flex min-w-0 flex-1 items-center gap-3 py-2 rounded-lg focus-ring",
        data: { turbo_frame: :modal, testid: "category-content" } do %>
    <span class="<%= class_names("flex shrink-0 items-center justify-center", sub ? "size-7 rounded-lg" : "size-8 rounded-[9px]") %>"
          style="background-color: color-mix(in oklab, <%= category.color %> 18%, transparent); color: <%= category.color %>" aria-hidden="true">
      <%= icon(category.lucide_icon.presence || "shapes", size: sub ? "xs" : "sm", color: "current") %>
    </span>
    <span class="min-w-0">
      <span class="block truncate text-[15px] font-semibold text-primary" data-testid="category-name"><%= category.name %></span>
      <% if category.destination_account %>
        <%# Where its money goes (Settings › category › Moves money to). %>
        <span class="flex items-center gap-1 truncate text-xs text-secondary"><%= icon("arrow-right", size: "xs", color: "current") %><%= category.destination_account.name %></span>
      <% end %>
    </span>
  <% end %>

  <% unless Current.user&.guest? %>
    <div class="shrink-0" data-testid="category-actions">
      <%= render DS::Menu.new do |menu| %>
        <% menu.with_item(variant: "link", text: t(".edit"), icon: "pencil", href: edit_category_path(category), data: { turbo_frame: :modal }) %>

        <% if has_transactions %>
          <% menu.with_item(variant: "link", text: t(".delete"), icon: "trash-2", href: new_category_deletion_path(category), destructive: true, data: { turbo_frame: :modal }) %>
        <% else %>
          <% menu.with_item(variant: "button", text: t(".delete"), icon: "trash-2", href: category_path(category), method: :delete) %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
