<%= content_for :page_title, t(".categories") %>
<%= content_for :page_actions do %>
  <% unless Current.user&.guest? %>
    <%= render DS::Menu.new do |menu| %>
      <% if Current.user.admin? %>
        <% locked = Current.family.categories_locked? %>
        <% menu.with_item(
            variant: "button",
            text: locked ? t(".unlock_categories") : t(".lock_categories"),
            href: toggle_lock_categories_path(locked: !locked),
            method: :patch,
            icon: locked ? "lock-open" : "lock") %>
      <% end %>
      <% menu.with_item(
          variant: "link",
          text: t(".merge"),
          href: merge_categories_path,
          frame: :modal,
          icon: "combine") %>
      <% menu.with_item(
          variant: "button",
          text: t(".delete_all"),
          href: destroy_all_categories_path,
          method: :delete,
          icon: "trash-2",
          confirm: CustomConfirm.for_resource_deletion("all categories", high_severity: true)) %>
    <% end %>

    <% unless Current.family.categories_locked? %>
      <%= render DS::Link.new(
        text: t(".new"),
        variant: "primary",
        icon: "plus",
        href: new_category_path,
        frame: :modal,
        class: "max-md:hidden"
      ) %>
    <% end %>
  <% end %>
<% end %>

<%# On a phone the add button is the floating one every list screen has
    (the owner, 2026-10-19); from md the header keeps its labelled button. %>
<% unless Current.user&.guest? || Current.family.categories_locked? %>
  <%= render DS::Fab.new(icon: "plus", label: t(".new"), href: new_category_path, frame: :modal, class: "md:hidden") %>
<% end %>

<%# iOS grouped (the Settings audit, 2026-10-19): the list's name above one
    card of rows, not a card holding a well holding a card. %>
<div>
  <% if Current.family.categories_locked? %>
    <div class="mb-4">
      <%= render DS::Alert.new(message: t(".locked_message"), variant: :info) %>
    </div>
  <% end %>

  <% if @categories.any? %>
    <div class="space-y-4">
      <%= render "categories/category_list_group",
                 categories: @categories,
                 family: Current.family,
                 category_groups: @category_groups,
                 category_ids_with_transactions: @category_ids_with_transactions %>
    </div>
  <% else %>
    <div class="flex justify-center items-center py-20 rounded-2xl bg-container shadow-border-xs">
      <div class="text-center flex flex-col items-center max-w-[500px]">
        <p class="text-sm text-secondary mb-4"><%= t(".empty") %></p>
        <% unless Current.family.categories_locked? || Current.user&.guest? %>
          <div class="flex items-center gap-2">
            <%= render DS::Button.new(
              text: t(".bootstrap"),
              href: bootstrap_categories_path,
            ) %>

            <%= render DS::Link.new(
              text: t(".new"),
              variant: "outline",
              icon: "plus",
              href: new_category_path,
              frame: :modal
            ) %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
