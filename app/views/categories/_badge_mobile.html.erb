<%# locals: (category:) %>
<% category ||= Category.uncategorized %>

<%# A tinted squircle in the category's colour (the Alive pass, 2026-10-18). %>
<div>
  <span class="flex lg:hidden items-center justify-center rounded-[14px] w-10 h-10 truncate focus-visible:outline-none focus-visible:ring-0"
      style="
        background-color: color-mix(in oklab, <%= category.color %> 14%, transparent);
        color: <%= category.color %>;">
    <% if category.lucide_icon.present? %>
      <%= icon category.lucide_icon, size: "md", color: "current" %>
    <% end %>
  </span>
</div>
