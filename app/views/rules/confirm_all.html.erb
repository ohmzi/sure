<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t("rules.apply_all.confirm_title")) %>

  <% dialog.with_body do %>
    <p class="text-secondary text-sm mb-4">
      <%= t("rules.apply_all.confirm_message",
            count: @rules.count,
            transactions: @total_affected_count) %>
    </p>

    <% if @preview_changes.any? %>
      <div data-testid="apply-all-preview" class="mb-4 rounded-xl bg-container-inset p-3 space-y-3">
        <div>
          <p class="text-sm font-medium text-primary"><%= t("rules.apply_all.preview.title") %></p>
          <p class="mt-1 text-xs text-secondary"><%= t("rules.apply_all.preview.description") %></p>
        </div>

        <% @preview_changes.each do |change| %>
          <div class="space-y-1">
            <p class="text-xs font-medium text-secondary">
              <%= change.rule.name.presence || change.rule.primary_condition_title %>
            </p>
            <p class="text-sm text-primary">
              <%= change.action.executor.label %>
              <span class="text-secondary">
                &middot; <%= t("rules.apply_all.preview.transactions", count: change.total) %>
              </span>
            </p>

            <% if change.groups.any? %>
              <ul class="space-y-1">
                <% change.groups.each do |group| %>
                  <li class="flex items-start justify-between gap-3 text-xs text-secondary">
                    <span class="min-w-0">
                      <% if group.from.nil? && group.to.nil? %>
                        <%= t("rules.apply_all.preview.async_hint") %>
                      <% else %>
                        <%= rule_preview_value(group.from, change.action_type) %>
                        <span aria-hidden="true">&rarr;</span>
                        <span class="text-primary"><%= rule_preview_value(group.to, change.action_type) %></span>
                      <% end %>
                    </span>
                    <span class="whitespace-nowrap"><%= group.count %></span>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @rules.any? { |r| r.actions.any? { |a| a.action_type == "auto_categorize" } } %>
      <div class="mb-4">
        <%= render DS::Alert.new(title: t("rules.apply_all.ai_cost_title"), variant: :info) do %>
          <% if @estimated_cost.present? %>
            <p>
              <%= t("rules.apply_all.ai_cost_message", transactions: @total_affected_count) %>
              <%= t("rules.apply_all.estimated_cost", cost: sprintf("%.4f", @estimated_cost)) %>
            </p>
          <% else %>
            <p>
              <%= t("rules.apply_all.ai_cost_message", transactions: @total_affected_count) %>
              <% if @selected_model.present? %>
                <span class="font-semibold"><%= t("rules.apply_all.cost_unavailable_model", model: @selected_model) %></span>
              <% else %>
                <span class="font-semibold"><%= t("rules.apply_all.cost_unavailable_no_provider") %></span>
              <% end %>
              <%= t("rules.apply_all.cost_warning") %>
            </p>
          <% end %>
          <p>
            <%= link_to t("rules.apply_all.view_usage"), settings_llm_usage_path, class: "text-link underline" %>
          </p>
        <% end %>
      </div>
    <% end %>

    <%= render DS::Button.new(
      text: t("rules.apply_all.confirm_button"),
      href: apply_all_rules_path,
      method: :post,
      full_width: true,
      data: { turbo_frame: "_top" }) %>
  <% end %>
<% end %>
