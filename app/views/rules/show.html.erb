<%# The rule review page. The list is the rule's actual matches, so a person can
    see what it does and fix either the rule's category or individual rows
    without leaving the rule. Mobile-first: every row and form stacks. %>
<%= content_for :page_title, @rule.name.presence || @rule.primary_condition_title %>

<div class="space-y-4">
  <% if @last_application %>
    <div class="rounded-xl bg-container p-4 shadow-border-xs">
      <%= render DS::Alert.new(title: t(".undo_available_title"), variant: :info) do %>
        <p class="text-sm text-secondary"><%= t(".undo_available_body") %></p>
        <div class="mt-3">
          <%= render DS::Button.new(
            text: t(".undo_last_run"),
            href: undo_rule_application_path(@last_application),
            method: :post,
            variant: "outline",
            size: :sm,
            confirm: CustomConfirm.new(
              title: t("rules.applications.undo_confirm_title"),
              body: t("rules.applications.undo_confirm_body"),
              btn_text: t("rules.applications.undo_confirm_button")
            )) %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="rounded-xl bg-container p-4 shadow-border-xs space-y-4">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0 space-y-1">
        <p class="text-xs font-medium uppercase tracking-wide text-secondary"><%= t(".conditions") %></p>
        <p class="text-primary font-medium"><%= @rule.primary_condition_title %></p>
        <p class="text-xs text-secondary"><%= t(".matched", count: @matched_count) %></p>
        <% if @rules_above.any? %>
          <p class="text-xs text-warning">
            <%= t(".conflict_warning", names: @rules_above.map { |rule| rule.name.presence || rule.primary_condition_title }.to_sentence) %>
          </p>
        <% end %>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <%= render DS::Link.new(text: t(".edit"), href: edit_rule_path(@rule), frame: :modal, variant: "outline", size: :sm) %>
        <%= render DS::Link.new(text: t(".apply"), href: confirm_rule_path(@rule), frame: :modal, variant: "secondary", size: :sm) %>
      </div>
    </div>

    <% if @category_action %>
      <%= form_with url: update_category_rule_path(@rule), method: :patch, namespace: "rule_category", class: "space-y-3" do |form| %>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
          <div class="min-w-0">
            <%= form.label :category_id, t(".rule_category"), class: "text-sm font-medium text-secondary" %>
            <%= form.select :category_id,
                  Category::Group.select_options(@categories),
                  { selected: @category_action.value },
                  class: "mt-1 w-full rounded-lg border border-primary bg-container px-3 py-2 text-sm text-primary focus-ring" %>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <label class="flex items-center gap-2 text-sm text-primary">
              <%= check_box_tag :apply_now, "1", false, class: "checkbox checkbox--light pointer-coarse:size-5" %>
              <%= t(".apply_now") %>
            </label>
            <%= render DS::Button.new(text: t(".update_rule"), type: :submit, variant: "primary", size: :sm) %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="rounded-xl bg-container p-4 shadow-border-xs space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 id="rule-matched-transactions" class="text-primary font-medium"><%= t(".transactions") %></h2>
      <p class="text-xs text-secondary"><%= t(".select_hint") %></p>
    </div>

    <% if @matched_entries.any? %>
      <%= form_with url: update_transactions_rule_path(@rule), method: :patch, namespace: "rule_selection", class: "space-y-3" do |form| %>
        <div class="divide-y divide-subdued rounded-xl bg-container-inset"
             role="group"
             aria-labelledby="rule-matched-transactions">
          <% @matched_entries.each do |entry| %>
            <label class="flex cursor-pointer items-start gap-3 px-3 py-3 text-sm transition-colors focus-within:bg-container-hover">
              <%= check_box_tag "entry_ids[]", entry.id, true, id: "entry_ids_#{entry.id}", class: "checkbox checkbox--light mt-0.5 shrink-0 pointer-coarse:size-5" %>
              <span class="min-w-0 grow space-y-0.5">
                <span class="flex flex-wrap items-baseline justify-between gap-2">
                  <span class="min-w-0 truncate font-medium text-primary"><%= entry.name %></span>
                  <span class="whitespace-nowrap font-medium privacy-sensitive <%= entry.amount.negative? ? "text-green-600" : "text-primary" %>">
                    <%= format_money(entry.amount_money.abs) %>
                  </span>
                </span>
                <span class="flex flex-wrap items-center gap-x-2 text-xs text-secondary">
                  <span><%= format_date(entry.date) %></span>
                  <span>·</span>
                  <span class="truncate"><%= entry.account.name %></span>
                  <span>·</span>
                  <span><%= entry.entryable.category&.name || t(".uncategorized") %></span>
                </span>
              </span>
            </label>
          <% end %>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div class="min-w-0">
            <%= form.label :category_id, t(".new_category"), class: "text-sm font-medium text-secondary" %>
            <%= form.select :category_id,
                  Category::Group.select_options(@categories),
                  {},
                  class: "mt-1 w-full rounded-lg border border-primary bg-container px-3 py-2 text-sm text-primary focus-ring" %>
            <% if @category_action %>
              <label class="mt-2 flex items-center gap-2 text-xs text-primary">
                <%= check_box_tag :update_rule, "1", false, class: "checkbox checkbox--light pointer-coarse:size-4" %>
                <%= t(".also_update_rule") %>
              </label>
            <% end %>
          </div>
          <%= render DS::Button.new(text: t(".update_selected"), type: :submit, variant: "primary", size: :sm) %>
        </div>
      <% end %>

      <%= render "shared/pagination", pagy: @pagy if @pagy.pages > 1 %>
    <% else %>
      <p class="text-sm text-secondary"><%= t(".no_transactions") %></p>
    <% end %>
  </div>
</div>
