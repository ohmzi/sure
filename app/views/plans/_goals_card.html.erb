<%# locals: (goals:, summary:, linkable_account_count:, family_has_goals:) %>

<%= render DS::Card.new(class: "rounded-[26px] gap-4") do %>
  <%# Headed as Home's cards are: a bold title, its detail beside it, the
      action at the end (the owner, 2026-10-19). %>
  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
    <h2 class="text-xl font-extrabold tracking-tight text-primary shrink-0"><%= t(".title") %></h2>
    <% if goals.any? %>
      <span class="text-sm text-secondary"><%= t(".active_count", count: goals.size) %></span>
    <% end %>
    <% if goals.any? && linkable_account_count > 0 %>
      <div class="ml-auto shrink-0">
        <%# Same weight as the budget card's edit control (DS::Link,
            secondary, sm) so the two cards' header actions read as one
            family, not two different conventions. %>
        <%= render DS::Link.new(
          text: t(".new_goal"),
          variant: "secondary",
          size: "sm",
          icon: "plus",
          href: new_goal_path,
          frame: :modal
        ) %>
      </div>
    <% end %>
  </div>

  <% if goals.empty? %>
    <%# No *active* goals. The family may still have completed/archived ones
        on the goals index, and this card is the only route there for preview
        users (the Goals nav entry is gone) — hence the footer link below. %>
    <div class="flex-1 flex flex-col items-center justify-center text-center gap-3 py-6">
      <%= render DS::FilledIcon.new(icon: "target", hex_color: "var(--color-brand-500)", size: "lg") %>
      <p class="text-sm text-secondary max-w-xs"><%= t("goals.empty_state.body") %></p>
      <% if linkable_account_count > 0 %>
        <%= render DS::Link.new(
          text: t("goals.empty_state.new_goal"),
          variant: "primary",
          href: new_goal_path,
          icon: "plus",
          frame: :modal
        ) %>
      <% else %>
        <%= render DS::Link.new(
          text: t("goals.empty_state.add_account"),
          variant: "primary",
          href: new_account_path(return_to: plan_path),
          icon: "plus"
        ) %>
      <% end %>
    </div>
  <% else %>
    <div class="flex items-baseline gap-2">
      <span class="text-3xl font-extrabold tracking-tight text-primary tabular-nums privacy-sensitive">
        <%= format_money(summary[:saved_money]) %>
      </span>
      <% if summary[:target_money].positive? %>
        <span class="text-sm text-subdued privacy-sensitive">
          <%= t(".of_targets", total: format_money(summary[:target_money])) %>
        </span>
      <% end %>
    </div>
    <p class="text-xs text-subdued mt-1 mb-4">
      <%
        parts = []
        parts << t(".behind_count", count: summary[:behind_count]) if summary[:behind_count].positive?
        parts << t(".pending_count", count: summary[:pending_count]) if summary[:pending_count].positive?
      %>
      <%= parts.any? ? parts.join(" · ") : t(".all_on_pace") %>
    </p>

    <% if summary[:target_money].positive? %>
      <div class="h-1.5 bg-container-inset rounded-full overflow-hidden">
        <div class="h-full bg-inverse rounded-full"
             style="inline-size: <%= (summary[:saved_money].amount / summary[:target_money].amount * 100).clamp(0, 100).round(1) %>%"></div>
      </div>
    <% end %>

    <p class="mt-6 mb-1 text-[11px] font-medium uppercase tracking-wide text-secondary"><%= t(".active_goals") %></p>
    <div class="flex-1">
      <% shown_goals = goals.first(5) %>
      <% shown_goals.each_with_index do |goal, index| %>
        <%= link_to goal_path(goal), class: "flex items-center gap-3 py-2.5 group #{"border-b border-divider" unless index == shown_goals.size - 1}" do %>
          <%= render Goals::AvatarComponent.new(goal: goal, size: "md") %>
          <%# Name and amount share the first line, the status pill the next,
              the bar under them (the owner, 2026-10-19: on a phone the pill
              ran over the amount and squeezed the name out). %>
          <div class="flex-1 min-w-0 space-y-1.5">
            <div class="flex items-baseline justify-between gap-3">
              <span class="min-w-0 truncate text-[15px] font-semibold text-primary"><%= goal.name %></span>
              <span class="shrink-0 text-xs tabular-nums text-primary privacy-sensitive">
                <%= format_money(goal.current_balance_money) %><% if goal.target_amount.to_d.positive? %><span class="text-subdued">/<%= goal.target_amount_money.format(precision: 0) %></span><% end %>
              </span>
            </div>
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
              <%= render Goals::StatusPillComponent.new(goal: goal) %>
              <% if goal.open_pledges.any? %>
                <span class="text-xs text-warning">· <%= t(".pending_marker") %></span>
              <% end %>
            </div>
            <% if goal.target_amount.to_d.positive? %>
              <div class="h-1 bg-container-inset rounded-full overflow-hidden">
                <%# A depleted reserve wants attention as much as a goal off its
                    pace: the pill beside this bar is already amber for it, and
                    the bar was still neutral. %>
                <div class="h-full <%= goal.needs_attention? ? "bg-warning" : "bg-inverse" %> rounded-full"
                     style="inline-size: <%= goal.progress_percent.clamp(0, 100) %>%"></div>
              </div>
            <% elsif goal.months_of_runway.present? %>
              <p class="text-xs text-subdued">
                <%= t(".runway", months: goal.months_of_runway, pace: goal.pace_money.format(precision: 0)) %>
              </p>
            <% end %>
          </div>
          <%= icon("chevron-right", size: "sm", class: "text-subdued shrink-0") %>
        <% end %>
      <% end %>
    </div>

  <% end %>

  <% if family_has_goals %>
    <%= link_to goals_path,
          class: "group mt-auto -mx-5 -mb-5 flex items-center justify-between rounded-b-[26px] border-t border-subdued px-5 py-3.5 text-sm font-semibold text-link hover:bg-container-hover transition-colors focus-ring" do %>
      <%= t(".all_goals") %>
      <%= icon("chevron-right", size: "sm", color: "current", class: "transition-transform group-hover:translate-x-0.5") %>
    <% end %>
  <% end %>
<% end %>
