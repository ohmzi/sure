<%# locals: (chat:) %>

<%# The card's shadow deepens under a pointer (no lift: its menu opens as a
    fixed panel, which a transform would displace). %>
<%= tag.div class: "flex items-center justify-between px-4 py-3 bg-container shadow-border-xs rounded-lg transition-shadow duration-200 hover:shadow-border-md" do %>
  <div class="grow truncate">
    <%= turbo_frame_tag dom_id(chat, :title), title: chat.title do %>
      <%= render "chats/chat_title", chat: chat, ctx: "list" %>
    <% end %>

    <p class="text-sm text-secondary">
      <%= time_ago_in_words(chat.updated_at) %> ago
    </p>
  </div>

  <%= render DS::Menu.new(icon_vertical: true) do |menu| %>
    <% menu.with_item(
      variant: "link",
      text: t(".edit_chat_title"),
      href: edit_chat_path(chat, ctx: "list"),
      icon: "pencil",
      frame: dom_id(chat, "title")) %>

    <% menu.with_item(
      variant: "button",
      text: t(".delete_chat"),
      href: chat_path(chat),
      icon: "trash-2",
      method: :delete,
      confirm: CustomConfirm.for_resource_deletion("chat")) %>
  <% end %>
<% end %>
