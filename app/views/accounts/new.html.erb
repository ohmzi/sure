<%= render layout: "accounts/new/container", locals: { title: t(".title") } do %>
  <div class="text-sm"
       <% if @provider_configs.any? { |c| c[:key] == "lunchflow" } %>
         data-controller="lunchflow-preload"
       <% end %>>
    <%# Milestone B (design D2): the two document rows became ONE, and it is a
        plain link to the Documents page — the ONE place to upload (the owner's
        ask). There is no second dropzone here: the dashboard has neither
        #documents_grid nor #documents_intake_status, so mounting the intake here
        would post into nothing and an upload or a refusal would be invisible.
        The link escapes the modal frame (`_top`), like the Import row below, so
        it lands on the full page rather than inside the popup. The label uses an
        absolute i18n key: inside the container layout's block a relative t()
        would resolve against accounts.new.container, not accounts.new. %>
    <%# Opened from the Accounts tab, the sheet offers only accounts — the
        document row lives on the Documents tab (the owner, 2026-10-17). %>
    <% unless params[:return_to] == accounts_path %>
    <%= link_to documents_path,
                data: { turbo_frame: :_top },
                class: "group flex items-center gap-4 w-full text-center focus:outline-hidden hover:bg-surface-hover focus:bg-surface-hover text-primary border border-transparent block px-2 rounded-lg p-2" do %>
      <%= render DS::FilledIcon.new(icon: "receipt-text", hex_color: "#12B76A") %>
      <%= t("accounts.new.document") %>
      <%= icon("chevron-right", size: "sm", class: "ml-auto shrink-0 text-subdued transition-colors group-hover:text-secondary") %>
    <% end %>
    <% end %>

    <% unless params[:classification] == "liability" %>
      <%= render "account_type", accountable: Depository.new %>
      <%= render "account_type", accountable: Investment.new %>
      <%= render "account_type", accountable: Crypto.new %>
      <%= render "account_type", accountable: Property.new %>
      <%= render "account_type", accountable: Vehicle.new %>
    <% end %>

    <% unless params[:classification] == "asset" %>
      <%= render "account_type", accountable: CreditCard.new %>
      <%= render "account_type", accountable: Loan.new %>
    <% end %>

    <% unless params[:classification] == "liability" %>
      <%= render "account_type", accountable: OtherAsset.new %>
    <% end %>

    <% unless params[:classification] == "asset" %>
      <%= render "account_type", accountable: OtherLiability.new %>
    <% end %>

    <% unless params[:return_to].present? %>
      <%= button_to imports_path(import: { type: "AccountImport" }),
              data: { turbo_frame: :_top },
            class: "flex items-center gap-4 w-full text-center focus:outline-hidden hover:bg-surface-hover focus:bg-surface-hover text-primary border border-transparent block px-2 rounded-lg p-2" do %>
        <%= render DS::FilledIcon.new(
          icon: "download",
          hex_color: "#F79009",
        ) %>

        <%= t("accounts.new.import_accounts") %>
      <% end %>
    <% end %>
  </div>
<% end %>
