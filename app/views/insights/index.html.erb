<%= turbo_stream_from Current.family, :insights %>

<div class="space-y-6 pb-6">
  <%# On a phone the title, its explanation and the refresh button stack, so
      the button never runs off the screen beside a long title (2026-10-17). %>
  <header class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-3xl font-bold text-primary tracking-tight"><%= t(".title") %></h1>
        <%= render DS::Pill.new(label: t("shared.preview"), size: :md) %>
      </div>
      <p class="text-sm text-secondary mt-1"><%= t(".subtitle") %></p>
    </div>

    <div class="shrink-0 self-start">
      <%= render "insights/refresh_button", pending: false %>
    </div>
  </header>

  <%= render "insights/list", insights: @insights, unread_ids: @unread_ids %>
</div>
