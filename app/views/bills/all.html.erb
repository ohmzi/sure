<div class="space-y-4 pb-6 lg:pb-12">
  <%= render "bills/view_switcher", active: "all" %>

  <%# One row (the owner, 2026-10-18): the search across the width and one
      Filters pill, its count showing what is on, that opens a sheet with
      status, type and order. The sheet's fields are in the same form, so a
      change submits as it always did. %>
  <% active_filters = %i[status bill_type sort].count { |key| params.dig(:q, key).present? } %>
  <%= styled_form_with url: bills_path, method: :get, scope: :q,
        data: { controller: "auto-submit-form" },
        class: "flex items-center gap-2" do |form| %>
    <%= hidden_field_tag :view, "all" %>
    <%= render DS::SearchInput.new(
          variant: :filled,
          name: "q[search]",
          value: params.dig(:q, :search),
          placeholder: t(".search_placeholder"),
          class: "grow min-w-0",
          data: { "auto-submit-form-target": "auto" }) %>
    <button type="button"
            class="press relative inline-flex h-11 shrink-0 items-center gap-2 rounded-full bg-container px-4 text-sm font-semibold text-primary shadow-border-xs hover:bg-container-hover transition-colors focus-ring"
            aria-controls="bills_filter_sheet" aria-haspopup="dialog"
            aria-label="<%= t(".filters_aria", count: active_filters) %>"
            data-controller="sheet-opener" data-sheet-opener-sheet-value="bills_filter_sheet" data-action="sheet-opener#open">
      <%= icon("sliders-horizontal", size: "sm", color: "current") %>
      <span><%= t(".filters") %></span>
      <% if active_filters.positive? %>
        <span class="inline-flex size-5 items-center justify-center rounded-full bg-inverse text-[11px] font-bold text-inverse"><%= active_filters %></span>
      <% end %>
    </button>

    <%= render DS::Dialog.new(variant: "sheet", auto_open: false, disable_frame: true, width: "sm", id: "bills_filter_sheet") do |dialog| %>
      <% dialog.with_body do %>
        <h2 id="<%= dialog.title_id %>" class="text-2xl font-bold tracking-tight text-primary"><%= t(".filters_title") %></h2>
        <div class="mt-5 space-y-3">
          <%= form.select :status,
                options_for_select(
                  [ [ t(".any_status"), "" ] ] + BillsController::STATUS_FILTERS.map { |status| [ t(".status_filters.#{status}"), status ] },
                  params.dig(:q, :status)
                ),
                { label: t(".filter_status") },
                { "data-auto-submit-form-target": "auto" } %>
          <%= form.select :bill_type,
                options_for_select(
                  [ [ t(".any_type"), "" ] ] + RecurringTransaction.bill_types.keys.map { |type| [ t(".types.#{type}"), type ] },
                  params.dig(:q, :bill_type)
                ),
                { label: t(".filter_type") },
                { "data-auto-submit-form-target": "auto" } %>
          <%= form.select :sort,
                options_for_select(
                  [ [ t(".sort_due"), "" ], [ t(".sort_name"), "name" ], [ t(".sort_amount"), "amount" ] ],
                  params.dig(:q, :sort)
                ),
                { label: t(".filter_sort") },
                { "data-auto-submit-form-target": "auto" } %>
        </div>
        <div class="mt-5">
          <%= render DS::Button.new(text: t(".filters_done"), variant: :primary, size: :lg, full_width: true,
                                    type: "button", data: { action: "DS--dialog#close" }) %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%# What the Subscriptions tab existed to answer. It was a whole destination
      for a filter All bills already had, so the rollup now appears when that
      filter is on rather than living behind its own tab. %>
  <% if @subscription_rollup %>
    <%# A text-xl currency figure does not fit an 85px cell, which is what three
        columns leaves at 375px. %>
    <div class="grid grid-cols-1 sm:grid-cols-3 bg-container rounded-[26px] shadow-border-xs divide-y sm:divide-y-0 sm:divide-x divide-subdued">
      <div class="p-4 space-y-1">
        <p class="text-sm text-secondary"><%= t(".subscription_monthly") %></p>
        <p class="text-primary font-medium text-xl privacy-sensitive">
          <%= @subscription_rollup[:monthly] ? format_money(@subscription_rollup[:monthly]) : "–" %>
        </p>
        <% if @subscription_rollup[:unconvertible].positive? %>
          <p class="text-xs text-warning"><%= t("bills.index.unconvertible", count: @subscription_rollup[:unconvertible]) %></p>
        <% end %>
      </div>
      <div class="p-4 space-y-1">
        <p class="text-sm text-secondary"><%= t(".subscription_annual") %></p>
        <p class="text-primary font-medium text-xl privacy-sensitive">
          <%= @subscription_rollup[:annual] ? format_money(@subscription_rollup[:annual]) : "–" %>
        </p>
      </div>
      <div class="p-4 space-y-1">
        <p class="text-sm text-secondary"><%= t(".subscription_active") %></p>
        <p class="text-primary font-medium text-xl"><%= @subscription_rollup[:active_count] %></p>
      </div>
    </div>
  <% end %>

  <% if @all_series.empty? %>
    <div class="bg-container rounded-[26px] shadow-border-xs p-4">
      <%= render DS::EmptyState.new(
            icon: "receipt",
            title: t(".no_matches_title"),
            description: t(".no_matches_description")
          ) %>
    </div>
  <% else %>
    <%# A table on a phone is a table you scroll sideways to read. The same
        rows, the same filters, laid out the way the Calendar already does it:
        a purpose-built small-screen list rather than a squeezed desktop one.
        Switched on the container, not the viewport: the app shell's sidebars
        can squeeze a desktop window to phone-list widths, and a viewport
        breakpoint cannot see that. Four columns now, so the table fits from
        @2xl rather than from the width the seven it had needed. %>
    <div class="@container">
      <%# Each bill as one row on one card (the owner, 2026-10-18): its tile, the
          name on up to two lines, the cadence with how soon the next one is,
          the amount; a state pill only when it is not simply active. The whole
          row opens the bill; the ⋯ menu sits beside it. A paused or dismissed
          row recedes through its text (bills_series_tone). %>
      <div class="@2xl:hidden bg-container rounded-3xl shadow-border-xs overflow-hidden divide-y divide-subdued">
        <% @all_series.each do |series| %>
          <% next_date = series.next_expected_date %>
          <% in_days = next_date && (next_date - Date.current).to_i %>
          <div class="flex items-center gap-1 pr-2 transition-colors hover:bg-container-hover active:bg-surface-inset"
               data-controller="clickable-row"
               data-action="click->clickable-row#open">
            <%= link_to bill_path(series), data: { turbo_frame: "drawer", turbo_prefetch: false, clickable_row_target: "link" },
                  class: "flex items-center gap-3 min-w-0 flex-1 py-3 pl-4 focus-ring -outline-offset-2 rounded-lg" do %>
              <%= render "bills/series_avatar", series: series %>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold <%= bills_series_tone(series) %> line-clamp-2 break-words"><%= series.display_name %></p>
                <p class="text-xs text-secondary truncate">
                  <%= frequency_label(series) %>
                  <% if in_days && in_days >= 0 %>
                    &middot; <span class="font-semibold <%= in_days <= 3 ? "text-warning" : bills_series_tone(series) %>"><%= t(".in_days", count: in_days) %></span>
                  <% elsif next_date %>
                    &middot; <%= t(".next_short", date: bills_upcoming_date(next_date)) %>
                  <% end %>
                </p>
                <% unless series.active? %>
                  <span class="mt-1 inline-flex"><%= render DS::Pill.new(label: t("recurring_transactions.status.#{series.status}"), tone: recurring_status_pill_tone(series.status), marker: false) %></span>
                <% end %>
              </div>
              <p class="shrink-0 text-sm font-semibold <%= bills_series_amount_tone(series) %> tabular privacy-sensitive">
                <%= format_money(Money.new(series.amount.abs, series.currency)) %>
              </p>
            <% end %>

            <div class="shrink-0 text-secondary">
              <%= render "bills/series_menu", series: series %>
            </div>
          </div>
        <% end %>
      </div>

      <%# inset: false because this table is the card itself here: the fork's
          page drops the outer tray the upstream layout put it in. %>
      <%= render DS::Table.new(
            rows: @all_series,
            label: t("bills.views.all"),
            class: "hidden @2xl:block",
            row_opts: ->(_series) { { data: { controller: "clickable-row", action: "click->clickable-row#open" } } }
          ) do |table| %>
        <% table.with_column(t(".col_name"), class: "w-full max-w-0") do |series| %>
          <div class="flex items-center gap-3 @lg:gap-4">
            <%= render "bills/series_avatar", series: series %>
            <div class="min-w-0">
              <%= link_to series.display_name, bill_path(series), data: { turbo_frame: "drawer", turbo_prefetch: false, clickable_row_target: "link" }, class: "block truncate font-medium #{bills_series_tone(series)} hover:underline" %>
              <p class="text-xs text-secondary truncate"><%= bills_series_subline(series) %></p>
            </div>
          </div>
        <% end %>
        <% table.with_column(t(".col_next"), class: "text-secondary") do |series| %>
          <% if series.active? %>
            <%= series.next_expected_date ? bills_upcoming_date(series.next_expected_date) : "–" %>
          <% else %>
            <%= render DS::Pill.new(label: t("recurring_transactions.status.#{series.status}"), tone: recurring_status_pill_tone(series.status), marker: false) %>
          <% end %>
        <% end %>
        <% table.with_column(t(".col_amount"), numeric: true, class: "privacy-sensitive") do |series| %>
          <% amount = Money.new(series.amount.abs, series.currency) %>
          <% monthly = series.monthly_equivalent_amount.abs %>
          <span class="font-medium <%= bills_series_amount_tone(series) %>"><%= format_money(amount) %></span>
          <%# A monthly bill's monthly equivalent is its own amount, so the
              second line said "$5.99" under "$5.99". It only carries
              information for the other cadences. %>
          <% if monthly != amount %>
            <p class="text-xs text-secondary"><%= t(".monthly_equivalent", amount: format_money(monthly)) %></p>
          <% end %>
        <% end %>
        <% table.with_column(t(".col_actions"), align: :right) do |series| %>
          <%= render "bills/series_menu", series: series %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# Across every bill, not just the one you have open. Per-bill history lives
      in the bill's own detail. %>
  <% if @recent_price_changes&.any? %>
    <%= render DS::Section.new(title: t(".subscription_price_changes"), count: @recent_price_changes.size) do %>
      <% @recent_price_changes.each do |change| %>
        <div class="flex items-center justify-between gap-3 px-4 py-2">
          <div>
            <p class="text-sm text-primary"><%= change.recurring_transaction.display_name %></p>
            <p class="text-xs text-secondary"><%= l(change.effective_on, format: :long) %></p>
          </div>
          <p class="text-sm privacy-sensitive <%= change.new_amount > change.previous_amount ? "text-warning" : "text-success" %>">
            <%= t(".subscription_price_change_line",
                  from: format_money(change.previous_amount_money),
                  to: format_money(change.new_amount_money),
                  percent: change.previous_amount.positive? ? ((change.new_amount - change.previous_amount) / change.previous_amount * 100).round(1) : 0) %>
          </p>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
