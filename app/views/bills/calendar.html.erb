<div class="space-y-4 pb-6 lg:pb-12">
  <%= render "bills/view_switcher", active: "calendar" %>

  <%# The month, as the app's other steppers are (the owner, 2026-10-18): round
      previous/next buttons, the month in bold, and Today as a pill when you
      are elsewhere. %>
  <% step = "press inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-container text-primary shadow-border-xs hover:bg-container-hover transition-colors focus-ring" %>
  <div class="flex items-center gap-2">
    <%= link_to bills_path(view: "calendar", month: (@month - 1.month).strftime("%Y-%m")), class: step, aria: { label: t(".previous_month") } do %>
      <%= icon("chevron-left", size: "sm", color: "current") %>
    <% end %>
    <h2 class="min-w-0 grow truncate text-center text-xl font-extrabold tracking-tight text-primary"><%= l(@month, format: "%B %Y") %></h2>
    <% unless @month == Date.current.beginning_of_month %>
      <%= link_to t(".today"), bills_path(view: "calendar"),
            class: "press inline-flex h-8 shrink-0 items-center rounded-full button-bg-accent px-3 text-xs font-bold text-link hover:button-bg-accent-hover focus-ring" %>
    <% end %>
    <% if @at_forward_limit %>
      <span class="size-10 shrink-0" aria-hidden="true"></span>
    <% else %>
      <%= link_to bills_path(view: "calendar", month: (@month + 1.month).strftime("%Y-%m")), class: step, aria: { label: t(".next_month") } do %>
        <%= icon("chevron-right", size: "sm", color: "current") %>
      <% end %>
    <% end %>
  </div>

  <%# The month in three figures and a bar that fills as it is paid, in place
      of a sentence. %>
  <% currency = Current.family.currency %>
  <% expected = @month_expected || Money.new(0, currency) %>
  <% paid = @month_paid || Money.new(0, currency) %>
  <% left = [ expected - paid, Money.new(0, expected.currency) ].max %>
  <% paid_pct = expected.amount.positive? ? (paid.amount / expected.amount * 100).clamp(0, 100).round : 0 %>
  <section aria-label="<%= t(".summary_label") %>" class="rounded-3xl bg-container shadow-border-xs p-4 space-y-3 rise">
    <div class="grid grid-cols-3 gap-2">
      <% [ [ t(".expected"), expected, "text-primary" ], [ t(".paid"), paid, "text-success" ], [ t(".left"), left, "text-primary" ] ].each do |label, money, tone| %>
        <div class="min-w-0">
          <p class="text-xs font-medium text-secondary"><%= label %></p>
          <p class="truncate text-base font-extrabold tracking-tight tabular privacy-sensitive <%= tone %>"><%= format_money(money) %></p>
        </div>
      <% end %>
    </div>
    <div class="h-2 overflow-hidden rounded-full bg-surface-inset" role="presentation">
      <span class="grow-right block h-full rounded-full bg-success" style="width: <%= paid_pct %>%"></span>
    </div>
    <% if @month_unconvertible.positive? %>
      <p class="text-xs text-warning"><%= t("bills.index.unconvertible", count: @month_unconvertible) %></p>
    <% end %>
  </section>

  <%# Month grid: desktop and tablet. %>
  <div class="hidden md:block bg-container rounded-xl shadow-border-xs p-2">
    <div class="grid grid-cols-7 text-xs font-medium text-secondary uppercase">
      <% (0..6).each do |offset| %>
        <div class="px-2 py-1"><%= t("date.abbr_day_names")[offset] %></div>
      <% end %>
    </div>
    <%# One fade for the whole grid, not 42 cells staggering. %>
    <div class="grid grid-cols-7 gap-px bg-alpha-black-100 theme-dark:bg-alpha-white-200 rounded-lg overflow-hidden fade-in">
      <% (@grid_start..@grid_end).each do |day| %>
        <% in_month = day.between?(@month, @month.end_of_month) %>
        <div class="bg-container min-h-24 p-1.5 space-y-1 <%= "opacity-40" unless in_month %>">
          <%# Today wears a ring (the animation pass, 2026-10-18). %>
          <p class="text-xs <%= day == Date.current ? "inline-flex size-6 items-center justify-center rounded-full font-bold text-link ring-1 ring-link" : "text-secondary" %>">
            <%= day.day %>
          </p>
          <% (@by_day[day] || []).sort_by { |occurrence| -occurrence.resolved_expected_amount }.each do |occurrence| %>
            <%= render "bills/calendar_chip", occurrence: occurrence %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Phone: an agenda of the month's days that have bills (the owner,
      2026-10-18): a date tile beside each day's rows — today's in the brand
      colour — on one card split by hairlines. %>
  <div class="md:hidden rounded-3xl bg-container shadow-border-xs overflow-hidden divide-y divide-subdued rise">
    <% month_days = (@month..@month.end_of_month).select { |day| @by_day[day].present? } %>
    <% if month_days.empty? %>
      <p class="p-4 text-sm text-secondary"><%= t(".empty_month") %></p>
    <% else %>
      <% month_days.each do |day| %>
        <% today = day == Date.current %>
        <div class="flex gap-1 pl-3">
          <div class="flex w-11 shrink-0 flex-col items-center pt-3.5">
            <span class="flex h-12 w-11 flex-col items-center justify-center rounded-2xl leading-none <%= today ? "bg-inverse text-inverse" : "bg-surface-inset text-primary" %>">
              <span class="text-lg font-extrabold"><%= day.day %></span>
              <span class="text-[10px] font-semibold uppercase <%= today ? "" : "text-secondary" %>"><%= l(day, format: "%a") %></span>
            </span>
          </div>
          <div class="min-w-0 grow divide-y divide-subdued">
            <% @by_day[day].sort_by { |occurrence| -occurrence.resolved_expected_amount }.each do |occurrence| %>
              <%= render "bills/agenda_row", occurrence: occurrence %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
