<%= turbo_stream_from account %>

<%= turbo_frame_tag id do %>
  <%= tag.div class: "space-y-4 pb-5 lg:pb-32" do %>
    <%= render "accounts/show/header", account: account, title: title, subtitle: subtitle %>

    <%= render UI::Account::Chart.new(account: account, period: chart_period, view: chart_view, loan_chart: loan_chart) %>

    <% if (fx_coverage_start = fx_coverage_start_date).present? %>
      <div class="px-3">
        <%= render DS::Alert.new(
          message: t("accounts.show.limited_fx_history_warning", date: l(fx_coverage_start, format: :long)),
          variant: :warning
        ) %>
      </div>
    <% end %>

    <div data-testid="account-details">
      <% if tabs.count > 1 %>
        <%= render DS::Tabs.new(active_tab: active_tab, url_param_key: "tab") do |tabs_container| %>
          <% tabs_container.with_nav(classes: "max-w-fit") do |nav| %>
            <% tabs.each do |tab| %>
              <% nav.with_btn(id: tab, label: t("accounts.show.tabs.#{tab}", default: tab.to_s.humanize), classes: "px-6") %>
            <% end %>
          <% end %>

          <% tabs.each do |tab| %>
            <% tabs_container.with_panel(tab_id: tab) do %>
              <%= tab_content_for(tab) %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <%= tab_content_for(tabs.first) %>
      <% end %>
    </div>

    <% if can_manage_statements %>
      <%# The statement upload is a floating action instead of a card in the
          statements tab: one tap opens the file picker, and the chosen files
          submit immediately to the same endpoint the card used. %>
      <div class="fixed bottom-[calc(5rem_+_env(safe-area-inset-bottom))] right-4 z-40 md:bottom-6 md:right-6">
        <%= form_with url: account_statements_path, scope: :account_statement, multipart: true,
                      class: "contents", data: { controller: "auto-submit-form" } do |form| %>
          <%= form.hidden_field :account_id, value: account.id %>
          <%= form.file_field :files,
                              multiple: true,
                              accept: AccountStatement::ACCEPTED_FILE_EXTENSIONS.join(","),
                              class: "sr-only",
                              id: "account-statement-fab-#{account.id}",
                              data: {
                                "auto-submit-form-target": "auto",
                                "autosubmit-trigger-event": "change",
                                "autosubmit-debounce-timeout": "0"
                              } %>
          <label for="account-statement-fab-<%= account.id %>"
                 aria-label="<%= t("account_statements.form.upload_fab") %>"
                 class="flex h-14 w-14 cursor-pointer items-center justify-center rounded-full bg-inverse text-inverse shadow-lg transition hover:bg-inverse-hover focus-ring">
            <%= helpers.icon("plus", size: "lg", color: "white") %>
          </label>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
