<%# The "needs you" summary (design D5), in the Quicken Simplifi language: one
    bold indigo card with the count large, the breakdown under it, and a pill
    to show them. %>
<div id="documents_attention" class="flex flex-wrap items-center gap-x-4 gap-y-3 rounded-3xl bg-inverse px-5 py-4 text-inverse shadow-border-sm">
  <div class="min-w-0 grow">
    <p class="text-xl font-bold tracking-tight"><%= title %></p>
    <p class="text-sm opacity-80">
      <%= reasons.map { |count, key| t("document_browser.attention.reasons.#{key}", count: count) }.join(" · ") %>
    </p>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <% if missing_period.positive? %>
      <%= render DS::PillLink.new(text: t("document_browser.attention.review_missing_period", count: missing_period),
                                  href: account_statements_path(q: { attention: "missing_period" })) %>
    <% end %>
    <% if missing_printed_identity.positive? %>
      <%= render DS::PillLink.new(text: t("document_browser.attention.review_missing_identity", count: missing_printed_identity),
                                  href: account_statements_path(q: { attention: "missing_identity" })) %>
    <% end %>
    <% if duplicates.positive? %>
      <%= render DS::PillLink.new(text: t("document_browser.attention.review_duplicates", count: duplicates),
                                  href: documents_path(q: { duplicates: 1 })) %>
    <% end %>
    <% if pending_imports.positive? %>
      <%= render DS::PillLink.new(text: t("document_browser.attention.review_imports", count: pending_imports),
                                  href: imports_path) %>
    <% end %>
    <% if total.positive? %>
      <%= render DS::PillLink.new(text: t("document_browser.attention.show"),
                                  href: documents_path(q: { attention: 1 })) %>
    <% end %>
  </div>
</div>
