<%# The Documents page leaves room under its last row for the floating +. %>
<div id="document-browser" class="space-y-4 <%= documents? ? "pb-28" : "pb-6 lg:pb-12" %>">
  <header class="flex justify-between items-center text-primary">
    <h1 class="text-3xl font-bold tracking-tight"><%= title %></h1>
  </header>

  <%= upload %>

  <%# The design's "needs you" strip (D5), documents-only and absent when
      nothing needs a person. %>
  <%= attention if attention? %>

  <%= render "document_browser/filter_form", url: url, filters: filters, active: active_filter_chips,
        documents: documents?, tag_choices: tag_choices %>

  <% if rows.any? %>
    <%# RB1 (Milestone B Task 1, replaced by Task 3): the intake stream appends
        a freshly uploaded tile into #documents_grid. The Documents page grows a
        thumbnail grid; the Statements vault keeps its row list. %>
    <% grid_classes = "grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3" %>
    <% list_classes = "bg-container rounded-xl shadow-border-xs divide-y divide-subdued" %>
    <% grid_id = documents? ? "documents_grid" : nil %>
    <div class="<%= grid? ? grid_classes : list_classes %>"<%= tag.attributes(id: grid_id) %>>
      <% rows.each do |row| %>
        <% if grid? %>
          <%= render "document_browser/tile", row: row %>
        <% else %>
          <%= render "document_browser/row", row: row %>
        <% end %>
      <% end %>
    </div>
    <% if pagy.pages > 1 %>
      <div class="px-3 py-2">
        <%= render "shared/pagination", pagy: pagy %>
      </div>
    <% end %>
  <% elsif documents? %>
    <%# RB1: the append target must exist even when the page is empty — the
        first drop lands here, and the grid is already the shape it grows into. %>
    <div id="documents_grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3"></div>
    <%= render "document_browser/empty", filtered: active_filters?, url: url, documents: true %>
  <% else %>
    <%= render "document_browser/empty", filtered: active_filters?, url: url, documents: false %>
  <% end %>
</div>
