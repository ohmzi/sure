<%= tag.div data: { controller: "DS--menu", DS__menu_placement_value: placement, DS__menu_offset_value: offset, DS__menu_mobile_fullwidth_value: mobile_fullwidth, testid: testid } do %>
  <% if icon_only? %>
    <%= render DS::Button.new(variant: "icon", size: icon_button_size, icon: icon_vertical ? "more-vertical" : "more-horizontal", aria: { haspopup: "menu", expanded: "false", controls: menu_id }, data: { DS__menu_target: "button" }) %>
  <% elsif variant == :button %>
    <%= button %>
  <% end %>

  <%# Below lg a full-width menu is a bottom sheet (the owner's rule,
      2026-10-17: every popup on a phone is the same sheet) over this backdrop. %>
  <div data-DS--menu-target="backdrop" data-action="click->DS--menu#close" class="hidden fixed inset-0 z-40 bg-overlay backdrop-blur-sm transition-opacity duration-300 starting:opacity-0 motion-reduce:transition-none" aria-hidden="true"></div>
  <div id="<%= menu_id %>" data-DS--menu-target="content" class="group fixed px-2 lg:px-0 max-w-full hidden z-50" role="menu">
    <%# V2 (2026-10-19): on a computer a rounded white dropdown of hover rows;
        on a phone an iOS action sheet, the actions one white card on the
        sheet's lavender with Cancel in a card of its own below. %>
    <%= tag.div class: "popup-panel mx-auto min-w-[200px] shadow-border-xl bg-container rounded-[1.125rem] p-1.5 group-data-[sheet]:bg-surface group-data-[sheet]:rounded-b-none group-data-[sheet]:rounded-t-[2rem] group-data-[sheet]:px-4 group-data-[sheet]:pt-2 group-data-[sheet]:pb-[calc(env(safe-area-inset-bottom)+1rem)] origin-top transition-[transform,opacity] duration-200 ease-out starting:opacity-0 starting:scale-95 group-data-[sheet]:duration-[420ms] group-data-[sheet]:ease-[cubic-bezier(0.32,0.72,0,1)] group-data-[sheet]:starting:opacity-100 group-data-[sheet]:starting:scale-100 group-data-[sheet]:starting:translate-y-full motion-reduce:transition-none", style: ("max-width: #{max_width}" if max_width) do %>
      <div data-sheet-grabber class="hidden group-data-[sheet]:flex justify-center pt-1 pb-3 -mt-1 cursor-grab touch-none" aria-hidden="true">
        <span class="h-[5px] w-10 rounded-full bg-surface-inset-hover"></span>
      </div>
      <%= tag.div class: class_names("popup-group", "py-0.5 group-data-[sheet]:py-0" => !no_padding, "overflow-y-auto" => max_height), style: ("max-height: #{max_height}" if max_height) do %>
        <% items.each do |item| %>
          <%= item %>
        <% end %>
      <% end %>
      <button type="button" role="menuitem" tabindex="-1" data-action="DS--menu#close"
              class="press hidden group-data-[sheet]:flex mt-2.5 h-14 w-full items-center justify-center rounded-[1.25rem] bg-container shadow-border-xs text-[17px] font-bold text-link focus-ring">
        <%= t("ds.menu.cancel") %>
      </button>
    <% end %>
  </div>
<% end %>
