<%= tag.div data: { controller: "DS--popover", DS__popover_placement_value: placement, DS__popover_offset_value: offset, DS__popover_mobile_fullwidth_value: mobile_fullwidth, testid: testid } do %>
  <% if variant == :icon %>
    <%= render DS::Button.new(variant: "icon", icon: icon, aria_label: trigger_aria_label, aria: { haspopup: "dialog", expanded: "false", controls: panel_id }, data: { DS__popover_target: "button" }) %>
  <% elsif variant == :button %>
    <%= button %>
  <% elsif variant == :avatar %>
    <%# Avatar trigger needs an explicit accessible name — the inner
        avatar image is decorative. Caller must pass `aria_label:` or
        the fallback `ds.popover.avatar_default_label` is used. %>
    <button type="button"
            data-DS--popover-target="button"
            class="inline-flex items-center justify-center w-9 h-9 pointer-coarse:w-11 pointer-coarse:h-11 cursor-pointer rounded-full focus-ring"
            aria-label="<%= trigger_aria_label %>"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="<%= panel_id %>">
      <div class="w-9 h-9">
        <%= render "settings/user_avatar", avatar_url: avatar_url, initials: initials %>
      </div>
    </button>
  <% end %>

  <%# On a phone the panel is the bottom sheet every popup shares (2026-10-17). %>
  <div id="<%= panel_id %>" data-DS--popover-target="content" class="group fixed px-2 lg:px-0 max-w-full hidden z-50">
    <%# V2 (2026-10-19): a rounded white panel on a computer; on a phone a
        sheet on the lavender ground, its groups white cards (`popup-group`). %>
    <%= tag.div class: "popup-panel mx-auto min-w-[200px] shadow-border-xl bg-container rounded-[1.125rem] group-data-[sheet]:max-w-none group-data-[sheet]:bg-surface group-data-[sheet]:rounded-b-none group-data-[sheet]:rounded-t-[2rem] group-data-[sheet]:px-4 group-data-[sheet]:pt-2 group-data-[sheet]:pb-[calc(env(safe-area-inset-bottom)+1rem)] origin-top transition-[transform,opacity] duration-200 ease-out starting:opacity-0 starting:scale-95 group-data-[sheet]:duration-[420ms] group-data-[sheet]:ease-[cubic-bezier(0.32,0.72,0,1)] group-data-[sheet]:starting:opacity-100 group-data-[sheet]:starting:scale-100 group-data-[sheet]:starting:translate-y-full motion-reduce:transition-none", style: ("max-width: #{max_width}" if max_width) do %>
      <div data-sheet-grabber class="hidden group-data-[sheet]:flex justify-center pt-1 pb-3 -mt-1 cursor-grab touch-none" aria-hidden="true">
        <span class="h-[5px] w-10 rounded-full bg-surface-inset-hover"></span>
      </div>
      <%= header %>

      <%= tag.div class: class_names("py-1" => !no_padding, "group-data-[sheet]:rounded-[1.25rem] group-data-[sheet]:bg-container group-data-[sheet]:shadow-border-xs group-data-[sheet]:overflow-hidden" => sheet_card) do %>
        <%= custom_content %>
      <% end %>
    <% end %>
  </div>
<% end %>
