#!/usr/bin/env bash
# Run docker compose for the ohmzbudget project with secret files injected.
set -euo pipefail
cd "$(dirname "$0")"

[ -f .env ] || { echo "deploy/.env missing — create it first: cp -n deploy/.env.example deploy/.env" >&2; exit 1; }
# shellcheck disable=SC1091
set -a; . ./.env; set +a

require_secret() {
  local f="secrets/$1"
  [ -s "$f" ] || { echo "secret file $f is missing or empty — run deploy/bootstrap-secrets.sh" >&2; exit 1; }
  cat "$f"
}
# Declare and assign separately: `export X="$(…)"` takes the EXPORT builtin's
# status, so require_secret's `exit 1` dies in the command-substitution subshell
# and the script would press on with EMPTY secrets. A plain assignment to an
# already-exported variable propagates the failure and trips `set -e` — the
# property the R18 exemption above depends on.
export SECRET_KEY_BASE POSTGRES_PASSWORD PAPERLESS_DBPASS
SECRET_KEY_BASE="$(require_secret secret_key_base)"
POSTGRES_PASSWORD="$(require_secret postgres_password)"
PAPERLESS_DBPASS="$(require_secret paperless_db_password)"

exec docker compose -f compose.yml -f docker-compose.override.yml "$@"
