# Copy to deploy/.env and edit. deploy/.env is untracked (see .gitignore).
# Secret VALUES are NOT here — they live in deploy/secrets/ (see bootstrap-secrets.sh).
POSTGRES_USER=sure_user
POSTGRES_DB=sure_production
OHMZBUDGET_DOCUMENT_STORE_DIR=/rails/storage/document-store
ONBOARDING_STATE=invite_only
# The native OCR sidecar (M-A). It is internal-only; the app reaches it here.
OCR_SERVICE_URL=http://ocr:9000
OCR_LANG=en
# Assume a TLS-terminating proxy in front of the app. Keep this FALSE for direct
# loopback access (127.0.0.1:7300) - with true, Rails stamps https on every redirect
# and a plain-http browser session dies after login. Behind cloudflared the private
# network is trusted, so X-Forwarded-Proto: https is honoured either way.
RAILS_ASSUME_SSL=false
# First super_admin email for `ohmzbudget:first_run` — REPLACE before Task 7 (blocking).
ADMIN_EMAIL=owner@example.com
# Off-volume backup destination on the host (owner-owned; /var/backups is not writable by uid 1000).
BACKUP_DIR=/home/ohmz/ohmzbudget-backups/backups
BACKUP_KEEP_DAYS=14
